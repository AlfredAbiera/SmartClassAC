@page "/first-access"
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>First Access | SmartClass AC</PageTitle>

<main class="first-access-page">
    <section class="first-access-card" aria-labelledby="first-access-title">
        <div class="first-access-icon" aria-hidden="true"><i class="fas fa-shield-halved"></i></div>
        <p class="first-access-eyebrow">SMARTCLASS AC · FIRST ACCESS</p>
        <h1 id="first-access-title">Set the administrator recovery email</h1>
        <p class="first-access-copy">
            The default administrator account is ready. Add its registered email before signing in so account recovery can be handled securely.
        </p>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="first-access-message" role="alert">@message</div>
        }

        <form @onsubmit="SaveEmail">
            <label for="admin-email">Administrator email</label>
            <div class="first-access-input">
                <i class="fas fa-envelope" aria-hidden="true"></i>
                <input id="admin-email"
                       type="email"
                       autocomplete="email"
                       placeholder="admin@school.edu"
                       @bind="email"
                       required />
            </div>
            <button type="submit" disabled="@isSaving">
                @(isSaving ? "Saving email…" : "Save and continue to login")
                @if (!isSaving) { <i class="fas fa-arrow-right" aria-hidden="true"></i> }
            </button>
        </form>

        <p class="first-access-footnote"><i class="fas fa-lock"></i> The administrator username and password are set securely in the server configuration.</p>
    </section>
</main>

@code {
    private string email = string.Empty;
    private string message = string.Empty;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsInitialAdminSetupRequiredAsync())
        {
            Navigation.NavigateTo("/login");
        }
    }

    private async Task SaveEmail()
    {
        if (isSaving)
        {
            return;
        }

        isSaving = true;
        message = string.Empty;
        try
        {
            var result = await AuthService.CompleteInitialAdminSetupAsync(email);
            if (result.Succeeded)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            message = result.Error ?? "The administrator email could not be saved.";
        }
        catch
        {
            message = "The administrator email could not be saved. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }
}

<style>
    .first-access-page {
        display: grid;
        min-height: 100vh;
        padding: 1.5rem;
        place-items: center;
        background: radial-gradient(circle at 10% 8%, rgba(82, 190, 255, .24), transparent 32rem), linear-gradient(145deg, #effaff, #f8fbff 50%, #e5f2ff);
    }

    .first-access-card {
        width: min(100%, 34rem);
        padding: clamp(2rem, 6vw, 3.5rem);
        border: 1px solid rgba(26, 115, 232, .16);
        border-radius: 1.5rem;
        background: rgba(255, 255, 255, .9);
        box-shadow: 0 25px 70px rgba(26, 89, 162, .16);
    }

    .first-access-icon {
        display: grid;
        width: 3.5rem;
        height: 3.5rem;
        margin-bottom: 1.3rem;
        place-items: center;
        color: #fff;
        border-radius: 1rem;
        background: linear-gradient(135deg, #1a73e8, #124d9a);
        font-size: 1.35rem;
        box-shadow: 0 10px 25px rgba(26, 115, 232, .27);
    }

    .first-access-eyebrow {
        margin: 0 0 .65rem;
        color: #1a73e8;
        font-size: .73rem;
        font-weight: 800;
        letter-spacing: .1em;
    }

    .first-access-card h1 {
        margin: 0;
        color: #172033;
        font-size: clamp(1.7rem, 4vw, 2.2rem);
        line-height: 1.15;
    }

    .first-access-copy {
        margin: 1rem 0 1.75rem;
        color: #5c6a80;
        line-height: 1.65;
    }

    .first-access-card label {
        display: block;
        margin-bottom: .5rem;
        color: #344054;
        font-size: .9rem;
        font-weight: 700;
    }

    .first-access-input {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: 0 .9rem;
        border: 1px solid #d6e0ee;
        border-radius: .8rem;
        background: #fff;
    }

    .first-access-input:focus-within { border-color: #1a73e8; box-shadow: 0 0 0 4px rgba(26, 115, 232, .1); }
    .first-access-input i { color: #1a73e8; }
    .first-access-input input { width: 100%; padding: .95rem 0; border: 0; outline: 0; color: #172033; }

    .first-access-card button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        gap: .65rem;
        margin-top: 1.2rem;
        padding: .95rem 1.2rem;
        color: #fff;
        border: 0;
        border-radius: .8rem;
        background: linear-gradient(135deg, #1a73e8, #124d9a);
        font-weight: 800;
        cursor: pointer;
    }

    .first-access-card button:disabled { cursor: wait; opacity: .7; }
    .first-access-message { margin-bottom: 1rem; padding: .75rem .9rem; color: #9a3412; border-radius: .65rem; background: #fff4ed; font-size: .9rem; }
    .first-access-footnote { margin: 1.4rem 0 0; color: #667085; font-size: .78rem; line-height: 1.5; }
    .first-access-footnote i { margin-right: .35rem; color: #1a73e8; }
</style>
