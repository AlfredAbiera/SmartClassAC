@page "/forgot-password"
@inject IAuthService AuthService

<PageTitle>Forgot password | SmartClass AC</PageTitle>

<main class="account-recovery-page">
    <section class="account-recovery-card" aria-labelledby="forgot-password-title">
        <div class="account-recovery-icon" aria-hidden="true"><i class="fas fa-key"></i></div>
        <p class="account-recovery-eyebrow">SMARTCLASS AC · ACCOUNT RECOVERY</p>
        <h1 id="forgot-password-title">Reset your password</h1>
        <p class="account-recovery-copy">
            Enter the registered email address for your active account. We will send a single-use reset link that expires in 15 minutes.
        </p>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="account-recovery-message @(isSuccess ? "success" : "error")" role="alert">@message</div>
        }

        @if (!isSuccess)
        {
            <form @onsubmit="RequestReset" @onsubmit:preventDefault="true">
                <label for="registered-email">Registered email</label>
                <div class="account-recovery-input">
                    <i class="fas fa-envelope" aria-hidden="true"></i>
                    <input id="registered-email"
                           type="email"
                           autocomplete="email"
                           placeholder="name@school.edu"
                           @bind="email"
                           required />
                </div>
                <button type="submit" disabled="@isSubmitting">
                    @(isSubmitting ? "Sending reset link…" : "Send reset link")
                    @if (!isSubmitting) { <i class="fas fa-paper-plane" aria-hidden="true"></i> }
                </button>
            </form>
        }

        <p class="account-recovery-footer"><a href="/login"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to login</a></p>
    </section>
</main>

@code {
    private string email = string.Empty;
    private string message = string.Empty;
    private bool isSubmitting;
    private bool isSuccess;

    private async Task RequestReset()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        message = string.Empty;
        try
        {
            var result = await AuthService.RequestPasswordResetAsync(email);
            isSuccess = result.Succeeded;
            message = result.Succeeded
                ? "A reset link was sent. Open it within 15 minutes to choose a new password."
                : result.Error ?? "The reset link could not be requested.";
        }
        catch
        {
            isSuccess = false;
            message = "The reset link could not be requested. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}

<style>
    .account-recovery-page { display: grid; min-height: 100vh; padding: 1.5rem; place-items: center; background: radial-gradient(circle at 10% 8%, rgba(82, 190, 255, .24), transparent 32rem), linear-gradient(145deg, #effaff, #f8fbff 50%, #e5f2ff); }
    .account-recovery-card { width: min(100%, 34rem); padding: clamp(2rem, 6vw, 3.5rem); border: 1px solid rgba(26, 115, 232, .16); border-radius: 1.5rem; background: rgba(255, 255, 255, .92); box-shadow: 0 25px 70px rgba(26, 89, 162, .16); }
    .account-recovery-icon { display: grid; width: 3.5rem; height: 3.5rem; margin-bottom: 1.3rem; place-items: center; color: #fff; border-radius: 1rem; background: linear-gradient(135deg, #1a73e8, #124d9a); font-size: 1.35rem; box-shadow: 0 10px 25px rgba(26, 115, 232, .27); }
    .account-recovery-eyebrow { margin: 0 0 .65rem; color: #1a73e8; font-size: .73rem; font-weight: 800; letter-spacing: .1em; }
    .account-recovery-card h1 { margin: 0; color: #172033; font-size: clamp(1.7rem, 4vw, 2.2rem); line-height: 1.15; }
    .account-recovery-copy { margin: 1rem 0 1.75rem; color: #5c6a80; line-height: 1.65; }
    .account-recovery-card label { display: block; margin-bottom: .5rem; color: #344054; font-size: .9rem; font-weight: 700; }
    .account-recovery-input { display: flex; align-items: center; gap: .75rem; padding: 0 .9rem; border: 1px solid #d6e0ee; border-radius: .8rem; background: #fff; }
    .account-recovery-input:focus-within { border-color: #1a73e8; box-shadow: 0 0 0 4px rgba(26, 115, 232, .1); }
    .account-recovery-input i { color: #1a73e8; }
    .account-recovery-input input { width: 100%; padding: .95rem 0; border: 0; outline: 0; color: #172033; }
    .account-recovery-card button { display: inline-flex; align-items: center; justify-content: center; width: 100%; gap: .65rem; margin-top: 1.2rem; padding: .95rem 1.2rem; color: #fff; border: 0; border-radius: .8rem; background: linear-gradient(135deg, #1a73e8, #124d9a); font-weight: 800; cursor: pointer; }
    .account-recovery-card button:disabled { cursor: wait; opacity: .7; }
    .account-recovery-message { margin-bottom: 1rem; padding: .75rem .9rem; border-radius: .65rem; font-size: .9rem; line-height: 1.5; }
    .account-recovery-message.error { color: #9a3412; background: #fff4ed; }
    .account-recovery-message.success { color: #166534; background: #edfdf3; }
    .account-recovery-footer { margin: 1.4rem 0 0; font-size: .86rem; text-align: center; }
    .account-recovery-footer a { color: #1a73e8; font-weight: 700; text-decoration: none; }
    .account-recovery-footer a:hover { text-decoration: underline; }
    .account-recovery-footer i { margin-right: .35rem; }
</style>
