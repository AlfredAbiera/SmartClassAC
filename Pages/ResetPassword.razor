@page "/reset-password"
@using Microsoft.AspNetCore.Components
@inject IAuthService AuthService

<PageTitle>Choose a new password | SmartClass AC</PageTitle>

<main class="new-password-page">
    <section class="new-password-card" aria-labelledby="reset-password-title">
        <div class="new-password-icon" aria-hidden="true"><i class="fas fa-lock"></i></div>
        <p class="new-password-eyebrow">SMARTCLASS AC · ACCOUNT RECOVERY</p>
        <h1 id="reset-password-title">Choose a new password</h1>

        @if (completed)
        {
            <div class="new-password-message success" role="alert">Your password was changed. You can now sign in with the new password.</div>
            <a class="new-password-button" href="/login">Continue to login <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
        }
        else
        {
            <p class="new-password-copy">Use at least 10 characters, including an uppercase letter, lowercase letter, and number.</p>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="new-password-message error" role="alert">@message</div>
            }

            <form @onsubmit="SavePassword" @onsubmit:preventDefault="true">
                <label for="new-password">New password</label>
                <div class="new-password-input">
                    <i class="fas fa-lock" aria-hidden="true"></i>
                    <input id="new-password" type="password" autocomplete="new-password" @bind="newPassword" required />
                </div>

                <label for="confirm-password">Confirm new password</label>
                <div class="new-password-input">
                    <i class="fas fa-lock" aria-hidden="true"></i>
                    <input id="confirm-password" type="password" autocomplete="new-password" @bind="confirmPassword" required />
                </div>

                <button type="submit" disabled="@isSubmitting">
                    @(isSubmitting ? "Updating password…" : "Update password")
                    @if (!isSubmitting) { <i class="fas fa-check" aria-hidden="true"></i> }
                </button>
            </form>
        }

        <p class="new-password-footer"><a href="/login"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to login</a></p>
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string message = string.Empty;
    private bool isSubmitting;
    private bool completed;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            message = "This reset link is invalid or incomplete. Request a new link from the login page.";
        }
    }

    private async Task SavePassword()
    {
        if (isSubmitting || string.IsNullOrWhiteSpace(Token))
        {
            return;
        }

        isSubmitting = true;
        message = string.Empty;
        try
        {
            var result = await AuthService.ResetPasswordAsync(Token, newPassword, confirmPassword);
            if (result.Succeeded)
            {
                completed = true;
                newPassword = string.Empty;
                confirmPassword = string.Empty;
                return;
            }

            message = result.Error ?? "The password could not be updated.";
        }
        catch
        {
            message = "The password could not be updated. Please request a new reset link and try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}

<style>
    .new-password-page { display: grid; min-height: 100vh; padding: 1.5rem; place-items: center; background: radial-gradient(circle at 10% 8%, rgba(82, 190, 255, .24), transparent 32rem), linear-gradient(145deg, #effaff, #f8fbff 50%, #e5f2ff); }
    .new-password-card { width: min(100%, 34rem); padding: clamp(2rem, 6vw, 3.5rem); border: 1px solid rgba(26, 115, 232, .16); border-radius: 1.5rem; background: rgba(255, 255, 255, .92); box-shadow: 0 25px 70px rgba(26, 89, 162, .16); }
    .new-password-icon { display: grid; width: 3.5rem; height: 3.5rem; margin-bottom: 1.3rem; place-items: center; color: #fff; border-radius: 1rem; background: linear-gradient(135deg, #1a73e8, #124d9a); font-size: 1.35rem; box-shadow: 0 10px 25px rgba(26, 115, 232, .27); }
    .new-password-eyebrow { margin: 0 0 .65rem; color: #1a73e8; font-size: .73rem; font-weight: 800; letter-spacing: .1em; }
    .new-password-card h1 { margin: 0; color: #172033; font-size: clamp(1.7rem, 4vw, 2.2rem); line-height: 1.15; }
    .new-password-copy { margin: 1rem 0 1.75rem; color: #5c6a80; line-height: 1.65; }
    .new-password-card label { display: block; margin: 1rem 0 .5rem; color: #344054; font-size: .9rem; font-weight: 700; }
    .new-password-card label:first-of-type { margin-top: 0; }
    .new-password-input { display: flex; align-items: center; gap: .75rem; padding: 0 .9rem; border: 1px solid #d6e0ee; border-radius: .8rem; background: #fff; }
    .new-password-input:focus-within { border-color: #1a73e8; box-shadow: 0 0 0 4px rgba(26, 115, 232, .1); }
    .new-password-input i { color: #1a73e8; }
    .new-password-input input { width: 100%; padding: .95rem 0; border: 0; outline: 0; color: #172033; }
    .new-password-card button, .new-password-button { display: inline-flex; align-items: center; justify-content: center; width: 100%; gap: .65rem; margin-top: 1.2rem; padding: .95rem 1.2rem; color: #fff; border: 0; border-radius: .8rem; background: linear-gradient(135deg, #1a73e8, #124d9a); font-weight: 800; text-decoration: none; cursor: pointer; box-sizing: border-box; }
    .new-password-card button:disabled { cursor: wait; opacity: .7; }
    .new-password-message { margin: 1.25rem 0; padding: .75rem .9rem; border-radius: .65rem; font-size: .9rem; line-height: 1.5; }
    .new-password-message.error { color: #9a3412; background: #fff4ed; }
    .new-password-message.success { color: #166534; background: #edfdf3; }
    .new-password-footer { margin: 1.4rem 0 0; font-size: .86rem; text-align: center; }
    .new-password-footer a { color: #1a73e8; font-weight: 700; text-decoration: none; }
    .new-password-footer a:hover { text-decoration: underline; }
    .new-password-footer i { margin-right: .35rem; }
</style>
