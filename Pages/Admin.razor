    private void SelectEnrollmentAuthorization(string id)
    {
        authorizationPreparationId = id;
        authorizationAllowOccupied = false;
        authorizationConfirmed = false;
    }

    private async Task AuthorizeEnrollment()
    {
        if (!authorizationConfirmed || authorizationPreparationId is null)
        {
            Toast("Select and confirm the enrollment details.");
            return;
        }
        try
        {
            var preparation = enrollmentPreparations.FirstOrDefault(item =>
                item.Id == authorizationPreparationId && item.TeacherId == fingerprintTeacher?.Id);
            if (preparation is null) { Toast("The preparation is no longer available. Refresh and try again."); return; }
            var result = preparation.IsReplacement
                ? await AuthService.AuthorizeFingerprintReplacementAsync(preparation.DeviceRowId, preparation.TeacherId,
                    preparation.FingerPosition, preparation.Slot, preparation.Id)
                : await AuthService.AuthorizeFingerprintEnrollmentAsync(preparation.Id, authorizationAllowOccupied);
            if (!result.Succeeded) { Toast(result.Error ?? "Could not record enrollment consent."); return; }
            authorizationPreparationId = null;
            authorizationAllowOccupied = false;
            authorizationConfirmed = false;
            if (await LoadEnrollmentPreparations())
                Toast(preparation.IsReplacement
                    ? $"Five-minute consent recorded. On the scanner choose Replace finger and confirm slot {preparation.Slot}."
                    : "Five-minute consent recorded. Start enrollment on the enabled scanner.");
        }
        catch (MySqlConnector.MySqlException exception)
        {
            Logger.LogError(exception, "Could not record fingerprint enrollment consent.");
            Toast("Could not record consent. Check the database and migration 023.");
        }
    }

