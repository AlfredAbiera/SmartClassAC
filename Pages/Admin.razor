    private async Task SaveTeacher()
    {
        if (teacherOtpBusy) return;
        var wasCreate = editingTeacherId == 0;
        var create = new CreateTeacherRequest(newTeacherName, newTeacherUsername, newTeacherEmployeeNumber, string.IsNullOrWhiteSpace(newTeacherEmail) ? null : newTeacherEmail, newTeacherPhone, newTeacherPassword, string.IsNullOrWhiteSpace(newTeacherDevicePin) ? null : newTeacherDevicePin, teacherRegistrationOtp);
        var update = new UpdateAdminTeacherRequest(editingTeacherId, newTeacherName, newTeacherUsername, newTeacherEmployeeNumber, string.IsNullOrWhiteSpace(newTeacherEmail) ? null : newTeacherEmail, newTeacherPhone, string.IsNullOrWhiteSpace(newTeacherDevicePin) ? null : newTeacherDevicePin, string.IsNullOrWhiteSpace(newTeacherPassword) ? null : newTeacherPassword, teacherRegistrationOtp);
        teacherFormError = string.Empty;
        var validation = wasCreate ? TeacherAccountValidation.ValidateCreate(create) : TeacherAccountValidation.ValidateUpdate(update);
        if (!validation.Succeeded) { teacherFormError = validation.Error ?? "Check the teacher details."; return; }
        if (!teacherOtpStep && (wasCreate || !string.Equals(newTeacherPhone.Trim(), originalTeacherPhone, StringComparison.Ordinal)))
        {
            teacherOtpBusy = true;
            try
            {
                var sent = await AuthService.RequestMobileOtpAsync(wasCreate ? null : editingTeacherId, newTeacherPhone);
                if (!sent.Succeeded) { teacherFormError = sent.Error ?? "Could not send verification code."; return; }
                teacherOtpStep = true;
                teacherRegistrationOtp = string.Empty;
                Toast("Verification code submitted. Check the phone.");
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Could not request teacher mobile verification.");
                teacherFormError = "Could not request verification. Check the modem and configuration.";
            }
            finally { teacherOtpBusy = false; }
            return;
        }

        if (teacherOtpStep && !MobileVerificationCodes.IsValid(teacherRegistrationOtp))
        {
            teacherFormError = MobileVerificationCodes.RequirementMessage;
            return;
        }

        teacherOtpBusy = true;
        try
        {
            var result = wasCreate
                ? await AuthService.CreateTeacherAsync(create)
                : await AuthService.UpdateAdminTeacherAsync(update);
            if (!result.Succeeded) { teacherFormError = result.Error ?? "Teacher could not be saved."; return; }
            ClearTeacherForm();
            await ReloadAsync();
            Toast(wasCreate ? "Teacher account was stored. Fingerprint enrollment is not yet available." : "Teacher account was updated.");
        }
        finally { teacherOtpBusy = false; }
    }

