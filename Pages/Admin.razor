    private async Task Logout() { await AuthService.LogoutAsync(); await AuthStateProvider.NotifyUserLogoutAsync(); Navigation.NavigateTo("/auth/logout", true); }
    private string ScheduleTodayFor(long teacherId) =>
        schedules.Any(schedule => schedule.TeacherAccountId == teacherId && schedule.ScheduleDate == Today)
            ? "With Schedule"
            : "No schedule";

    private void OpenAddTeacher()
    {
        ClearTeacherForm();
        teacherModalOpen = true;
    }

    private async Task SaveTeacher()
    {
        var wasCreate = editingTeacherId == 0;
        if (wasCreate && !teacherOtpStep)
        {
            if (!MobilePhones.IsValid(newTeacherPhone))
            {
                Toast(MobilePhones.RequirementMessage);
                return;
            }

            if (!string.IsNullOrWhiteSpace(newTeacherEmail) && !new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(newTeacherEmail.Trim()))
            {
                Toast("Enter a valid school email address, or leave it blank.");
                return;
            }

            teacherOtpStep = true;
            teacherRegistrationOtp = string.Empty;
            Toast(RegistrationOtp.SentHelpMessage);
            return;
        }

        var result = wasCreate
            ? await AuthService.CreateTeacherAsync(new CreateTeacherRequest(newTeacherName, newTeacherUsername, newTeacherEmployeeNumber, string.IsNullOrWhiteSpace(newTeacherEmail) ? null : newTeacherEmail, newTeacherPhone, newTeacherPassword, string.IsNullOrWhiteSpace(newTeacherDevicePin) ? null : newTeacherDevicePin, teacherRegistrationOtp))
            : await AuthService.UpdateAdminTeacherAsync(new UpdateAdminTeacherRequest(editingTeacherId, newTeacherName, newTeacherUsername, newTeacherEmployeeNumber, string.IsNullOrWhiteSpace(newTeacherEmail) ? null : newTeacherEmail, newTeacherPhone, string.IsNullOrWhiteSpace(newTeacherDevicePin) ? null : newTeacherDevicePin, string.IsNullOrWhiteSpace(newTeacherPassword) ? null : newTeacherPassword));
        if (!result.Succeeded) { Toast(result.Error ?? "Teacher could not be saved."); return; }
        ClearTeacherForm();
        await ReloadAsync();
        Toast(wasCreate ? "Teacher account was stored. Enroll fingerprints from the scanner device API." : "Teacher account was updated.");
    }

    private void BackFromTeacherOtp()
    {
        teacherOtpStep = false;
        teacherRegistrationOtp = string.Empty;
    }

