    private async Task PrepareGsmTest()
    {
        if (gsmTestPreparing || gsmTestSending || gsmTestConfirmation is not null) return;
        gsmTestStatus = string.Empty;
        var recipient = gsmTestPhone.Trim();
        if (!GsmSmsTransport.IsAsciiMobile(recipient))
        {
            gsmTestStatus = MobilePhones.RequirementMessage;
            return;
        }
        gsmTestPreparing = true;
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user?.Role != UserRole.Admin)
            {
                gsmTestStatus = "Administrator access is required.";
                return;
            }
            var settings = await GsmSettings.GetAsync();
            if (settings is null)
            {
                gsmTestStatus = "Save the modem settings before sending a test.";
                return;
            }
            if (settings.PortName != gsmPort || settings.BaudRate != gsmBaudRate)
            {
                gsmTestStatus = "Save the selected port and baud rate before testing.";
                return;
            }
            if (!GsmModemSettingsStore.GetPorts().Contains(settings.PortName, StringComparer.Ordinal))
            {
                gsmTestStatus = "The saved COM port is not available. Check the modem connection.";
                return;
            }
            if (active == "gsm")
            {
                gsmTestRecipient = recipient;
                gsmTestConfirmation = settings;
            }
        }
        catch (Exception exception) when (exception is MySqlConnector.MySqlException or PlatformNotSupportedException or UnauthorizedAccessException or System.Security.SecurityException or IOException)
        {
            Logger.LogError(exception, "Could not prepare GSM test.");
            gsmTestStatus = "Could not read the modem settings or available ports.";
        }
        finally
        {
            gsmTestPreparing = false;
        }
    }

    private void CancelGsmTest()
    {
        gsmTestConfirmation = null;
        gsmTestRecipient = string.Empty;
    }

    private async Task SendGsmTest()
    {
        if (gsmTestSending || gsmTestConfirmation is null) return;
        var settings = gsmTestConfirmation;
        var recipient = gsmTestRecipient;
        CancelGsmTest();
        gsmTestSending = true;
        gsmTestStatus = "Sending test SMS…";
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user?.Role != UserRole.Admin)
            {
                gsmTestStatus = "Administrator access is required.";
                return;
            }
            if (await GsmSettings.GetAsync() != settings || !GsmModemSettingsStore.GetPorts().Contains(settings.PortName, StringComparer.Ordinal))
            {
                gsmTestStatus = "Modem settings or port availability changed. Review them and confirm again.";
                return;
            }
            var result = await GsmTransport.SendTestAsync(settings, recipient);
            gsmTestStatus = result switch
            {
                GsmSmsResult.Accepted => "The modem accepted the test SMS. Check the phone; handset delivery is not guaranteed.",
                GsmSmsResult.DeliveryUnknown => "Delivery is uncertain. Check the phone before trying again; the message may have been sent.",
                GsmSmsResult.Rejected => "The modem rejected the request. Check the SIM, network and modem settings.",
                GsmSmsResult.NotConfigured => "Save the modem settings before sending a test.",
                GsmSmsResult.InvalidInput => "The saved settings or mobile number are invalid.",
                GsmSmsResult.Cancelled => "The test was cancelled before submission.",
                _ => "The modem is unavailable or did not respond. Check the port, power and baud rate."
            };
            if (result != GsmSmsResult.Accepted)
                Logger.LogWarning("GSM test SMS did not complete successfully: {Result}", result);
        }
        catch (Exception exception) when (exception is MySqlConnector.MySqlException or PlatformNotSupportedException or UnauthorizedAccessException or System.Security.SecurityException or IOException)
        {
            Logger.LogError(exception, "Could not send GSM test SMS.");
            gsmTestStatus = "Could not read modem settings or access the COM port. Check the portal logs.";
        }
        finally
        {
            gsmTestSending = false;
        }
    }

