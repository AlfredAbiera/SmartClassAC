    }

    private async Task OpenTeacherFingerprints(TeacherDirectoryEntry teacher)
    {
        try
        {
            var fingerprints = await AuthService.GetTeacherFingerprintsAsync(teacher.Id);
            var preparations = await AuthService.GetFingerprintEnrollmentPreparationsAsync();
            fingerprintTeacher = teacher;
            message = string.Empty;
            teacherFingerprints = fingerprints;
            var teacherIndex = teachers.FindIndex(item => item.Id == teacher.Id);
            if (teacherIndex >= 0)
                teachers[teacherIndex] = teachers[teacherIndex] with { FingerprintTemplateCount = fingerprints.Count };
            enrollmentPreparations = preparations;
            preparationsLoaded = true;
            preparationTeacherId = teacher.Id;
            preparationFinger = string.Empty;
            authorizationPreparationId = null;
            authorizationConfirmed = false;
            authorizationAllowOccupied = false;
            replacementSelection = null;
            replacementDevice = null;
            replacementConfirmed = false;
        }
        catch (MySqlConnector.MySqlException exception)
        {
            Logger.LogError(exception, "Could not load fingerprints for teacher {TeacherId}.", teacher.Id);
            Toast("Could not load teacher fingerprints. Check the database.");
        }
    }

