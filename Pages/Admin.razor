@page "/admin"
@using Microsoft.Extensions.Options
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject CustomAuthStateProvider AuthStateProvider
@inject IOptions<SchoolTimeOptions> SchoolTime
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Admin Dashboard | SmartClass AC</PageTitle>

<div class="dashboard-page">
    <aside class='dashboard-sidebar @(sidebarOpen ? "is-open" : string.Empty)'>
        <a class="dashboard-brand" href="/"><span class="brand-mark"><i class="fas fa-snowflake"></i></span><span>SmartClass <strong>AC</strong></span></a>
        <p class="workspace-label">ADMINISTRATOR WORKSPACE</p>
        <nav class="dashboard-nav" aria-label="Admin dashboard">
            <button class='@NavClass("overview")' @onclick='() => Navigate("overview")'><i class="fas fa-gauge-high"></i>Overview</button>
            <p class="nav-group-label">MANAGEMENT</p>
            <button class='@NavClass("teachers")' @onclick='() => Navigate("teachers")'><i class="fas fa-users"></i>Teachers</button>
            <button class='@NavClass("semesters")' @onclick='() => Navigate("semesters")'><i class="fas fa-layer-group"></i>Semesters</button>
            <button class='@NavClass("classrooms")' @onclick='() => Navigate("classrooms")'><i class="fas fa-door-open"></i>Classrooms</button>
            <button class='@NavClass("schedules")' @onclick='() => Navigate("schedules")'><i class="fas fa-calendar-days"></i>Schedules</button>
            <p class="nav-group-label">OPERATIONS</p>
            <button class='@NavClass("temperature")' @onclick='() => Navigate("temperature")'><i class="fas fa-temperature-half"></i>AC control</button>
            <button class='@NavClass("attendance")' @onclick='() => Navigate("attendance")'><i class="fas fa-clipboard-check"></i>Attendance</button>
            <p class="nav-group-label">SYSTEM</p>
            <button class='@NavClass("settings")' @onclick='() => Navigate("settings")'><i class="fas fa-gear"></i>System settings</button>
        </nav>
        <button class="sidebar-logout" @onclick="Logout"><i class="fas fa-arrow-right-from-bracket"></i>Log out</button>
    </aside>
    @if (sidebarOpen) { <button class="sidebar-scrim" aria-label="Close navigation" @onclick="ToggleSidebar"></button> }

    <main class="dashboard-main">
        <header class="dashboard-topbar"><button class="icon-button mobile-nav-toggle" aria-label="Open navigation" @onclick="ToggleSidebar"><i class="fas fa-bars"></i></button><div class="topbar-title"><span class="eyebrow">SMARTCLASS AC / ADMIN</span><h1>@Title</h1></div><div class="topbar-actions"><button class="profile-chip" @onclick='() => Navigate("settings")'><span>@AdminInitials</span><strong>@AdminName</strong><i class="fas fa-chevron-down"></i></button></div></header>
        <section class="dashboard-content">
            @if (!string.IsNullOrEmpty(message)) { <div class="dashboard-toast" role="status"><i class="fas fa-circle-check"></i>@message<button @onclick='() => message = string.Empty' aria-label="Dismiss"><i class="fas fa-xmark"></i></button></div> }
            @if (isLoading) { <article class="panel"><p class="form-help">Loading records…</p></article> }
            else if (active == "overview")
            {
                <div class="metric-grid"><article class="metric-card blue"><span class="metric-icon"><i class="fas fa-person-chalkboard"></i></span><div><small>TEACHER ACCOUNTS</small><strong>@teachers.Count(teacher => teacher.IsActive)</strong><p>Active biometric teachers</p></div></article><article class="metric-card violet"><span class="metric-icon"><i class="fas fa-door-open"></i></span><div><small>CLASSROOMS</small><strong>@classrooms.Count</strong><p>Connected room records</p></div></article><article class="metric-card teal"><span class="metric-icon"><i class="fas fa-calendar-days"></i></span><div><small>SCHEDULES TODAY</small><strong>@schedules.Count(schedule => schedule.ScheduleDate == Today)</strong><p>Conflict protected</p></div></article><article class="metric-card amber"><span class="metric-icon"><i class="fas fa-clipboard-check"></i></span><div><small>ATTENDANCE TODAY</small><strong>@attendance.Count(item => DateOnly.FromDateTime(item.TimeIn) == Today)</strong><p>Time-in records</p></div></article></div>
                <div class="dashboard-grid overview-grid"><article class="panel live-panel"><div class="panel-heading"><div><span class="eyebrow">LIVE ENVIRONMENT</span><h3>Classroom climate</h3></div><button class="text-button" @onclick='() => Navigate("temperature")'>View all <i class="fas fa-arrow-right"></i></button></div><div class="room-climate-list">@if (classrooms.Count == 0) { <p class="form-help">Add classrooms before creating schedules.</p> } @foreach (var room in classrooms.Take(4)) { <div class="room-climate-row"><span class="room-avatar"><i class="fas fa-building"></i></span><div><strong>@room.Name</strong><small>@room.Capacity seats</small></div><span class="mini-temp"><i class="fas fa-temperature-half"></i>@(room.CurrentTemperature ?? room.TargetTemperature)°C</span><span class='room-status @AcStatusTone(room.AcStatus)'>@AcStatusLabel(room.AcStatus)</span></div> }</div></article><article class="panel attendance-panel"><div class="panel-heading"><div><span class="eyebrow">AUTOMATED LOGS</span><h3>Today's attendance</h3></div><button class="text-button" @onclick='() => Navigate("attendance")'>View all <i class="fas fa-arrow-right"></i></button></div><div class="attendance-ring"><div><strong>@attendance.Count(item => DateOnly.FromDateTime(item.TimeIn) == Today)</strong><small>time-ins</small></div></div><p class="form-help">Class start and end operations write the attendance log.</p></article></div>
            }
            else if (active == "teachers")
            {
                <div class="page-intro list-intro">
                    <div class="split-intro">
                        <div><span>Create or update a teacher account, then enroll fingerprint IDs from the scanner device API using their device PIN.</span></div>
                        <div class="intro-actions">
                            <button class="primary-button intro-add-button" @onclick="OpenAddTeacher"><i class="fas fa-plus"></i>Add teacher</button>
                            <select class="intro-filter" @bind="teacherFilter" @bind:after="ResetTeacherPage" aria-label="Filter teachers">
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                                <option value="all">All teachers</option>
                                <option value="prints">With fingerprints</option>
                                <option value="no-prints">Without fingerprints</option>
                                <option value="scheduled">Scheduled today</option>
                                <option value="unscheduled">No schedule today</option>
                            </select>
                        </div>
                    </div>
                    <label class="intro-search"><i class="fas fa-magnifying-glass"></i><input type="search" @bind="teacherSearch" @bind:event="oninput" @bind:after="ResetTeacherPage" placeholder="Search teachers" aria-label="Search teachers" /></label>
                </div>
                <article class="panel list-view">
                    <div class="data-table-wrap"><table class="data-table">
                        <thead><tr><th>Teacher</th><th>Employee #</th><th>Mobile</th><th>Email</th><th>Fingerprints</th><th>Status</th><th>Schedule today</th><th>Actions</th></tr></thead>
                        <tbody>
                            @if (FilteredTeachers.Count == 0) { <tr><td colspan="8">@(teachers.Count == 0 ? "No teacher accounts have been created yet." : "No teachers match this search or filter.")</td></tr> }
                            @foreach (var teacher in PagedTeachers)
                            {
                                <tr>
                                    <td><div class="table-person"><span class="table-avatar">@Initials(teacher.DisplayName)</span><div><strong>@teacher.DisplayName</strong><small>@teacher.Username</small></div></div></td>
                                    <td>@(teacher.EmployeeNumber ?? "—")</td>
                                    <td>@(teacher.Phone ?? "—")</td>
                                    <td>@(string.IsNullOrWhiteSpace(teacher.Email) ? "—" : teacher.Email)</td>
                                    <td><span class='status-badge @(teacher.FingerprintTemplateCount > 0 ? "active" : "neutral")'>@teacher.FingerprintTemplateCount / 10</span></td>
                                    <td><span class='status-badge @(teacher.IsActive ? "active" : "neutral")'>@(teacher.IsActive ? "Active" : "Inactive")</span></td>
                                    <td>@ScheduleTodayFor(teacher.Id)</td>
                                    <td class="table-actions">
                                        <div class="table-action-group">
                                            <button type="button" class="table-action" title="Edit" aria-label="Edit teacher" @onclick='() => EditTeacher(teacher.Id)'><i class="fas fa-pen"></i></button>
                                            <button type="button" class='table-action @(teacher.IsActive ? "danger" : string.Empty)' title="@(teacher.IsActive ? "Deactivate" : "Activate")" aria-label="@(teacher.IsActive ? "Deactivate teacher" : "Activate teacher")" @onclick='() => ToggleTeacherActive(teacher)'><i class='fas @(teacher.IsActive ? "fa-toggle-off" : "fa-toggle-on")'></i></button>
                                            <button type="button" class="table-action danger" title="Remove" aria-label="Remove teacher" @onclick='() => OpenDelete("teacher", teacher.Id, teacher.DisplayName)'><i class="fas fa-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    <ListPager State="teacherPager" TotalCount="FilteredTeachers.Count" />
                </article>
            }
            else if (active == "semesters")
            {
                <div class="page-intro list-intro">
                    <div class="split-intro">
                        <div><span>Create a semester, enroll teachers, then assign Regular or Makeup schedules under that semester.</span></div>
                        <div class="intro-actions">
                            <button class="primary-button intro-add-button" @onclick="OpenAddSemester"><i class="fas fa-plus"></i>Add semester</button>
                            <select class="intro-filter" @bind="semesterFilter" @bind:after="ResetSemesterPage" aria-label="Filter semesters">
                                <option value="all">All semesters</option>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <label class="intro-search"><i class="fas fa-magnifying-glass"></i><input type="search" @bind="semesterSearch" @bind:event="oninput" @bind:after="ResetSemesterPage" placeholder="Search semesters" aria-label="Search semesters" /></label>
                </div>
                <article class="panel list-view">
                    <div class="data-table-wrap"><table class="data-table">
                        <thead><tr><th>Name</th><th>Dates</th><th>Status</th><th>Enrolled</th><th>Actions</th></tr></thead>
                        <tbody>
                            @if (FilteredSemesters.Count == 0) { <tr><td colspan="5">@(semesters.Count == 0 ? "No semesters have been created yet." : "No semesters match this search or filter.")</td></tr> }
                            @foreach (var semester in PagedSemesters)
                            {
                                <tr>
                                    <td><strong>@semester.Name</strong></td>
                                    <td>@semester.StartDate.ToString("MMM d, yyyy") – @semester.EndDate.ToString("MMM d, yyyy")</td>
                                    <td><span class='status-badge @(semester.IsActive ? "active" : "neutral")'>@(semester.IsActive ? "Active" : "Inactive")</span></td>
                                    <td>@teacherSemesters.Count(item => item.SemesterId == semester.Id)</td>
                                    <td class="table-actions">
                                        <div class="table-action-group">
                                            <button type="button" class="table-action" title="Enroll teachers" aria-label="Enroll teachers" @onclick='() => SelectSemesterForEnrollment(semester.Id)'><i class="fas fa-user-plus"></i></button>
                                            <button type="button" class='table-action @(semester.IsActive ? "danger" : string.Empty)' title="@(semester.IsActive ? "Deactivate" : "Activate")" aria-label="@(semester.IsActive ? "Deactivate semester" : "Activate semester")" @onclick='() => ToggleSemester(semester)'><i class='fas @(semester.IsActive ? "fa-toggle-off" : "fa-toggle-on")'></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    <ListPager State="semesterPager" TotalCount="FilteredSemesters.Count" />
                </article>
                @if (enrollSemesterId > 0)
                {
                    var selected = semesters.FirstOrDefault(item => item.Id == enrollSemesterId);
                    var enrolled = teacherSemesters.Where(item => item.SemesterId == enrollSemesterId).ToList();
                    var pagedEnrolled = enrollmentPager.Slice(enrolled);
                    <article class="panel enrollment-panel">
                        <div class="panel-heading"><div><span class="eyebrow">ENROLL TEACHERS</span><h3>@(selected?.Name ?? "Semester")</h3></div></div>
                        <div class="form-grid"><label>Teacher<select @bind="enrollTeacherId"><option value="0">Select a teacher</option>@foreach (var teacher in teachers.Where(item => item.IsActive)) { <option value="@teacher.Id">@teacher.DisplayName</option> }</select></label></div>
                        <div class="form-actions"><button class="primary-button" disabled="@(enrollTeacherId == 0)" @onclick="EnrollTeacher">Enroll</button></div>
                        <div class="data-table-wrap"><table class="data-table">
                            <thead><tr><th>Teacher</th><th>Employee #</th><th>Actions</th></tr></thead>
                            <tbody>
                                @if (enrolled.Count == 0) { <tr><td colspan="3">No teachers are enrolled in this semester yet.</td></tr> }
                                @foreach (var enrollment in pagedEnrolled)
                                {
                                    <tr>
                                        <td><span class="table-avatar">@Initials(enrollment.TeacherDisplayName)</span><strong>@enrollment.TeacherDisplayName</strong></td>
                                        <td>@(enrollment.EmployeeNumber ?? "—")</td>
                                        <td class="table-actions"><div class="table-action-group"><button type="button" class="table-action danger" title="Unenroll" aria-label="Unenroll teacher" @onclick='() => UnenrollTeacher(enrollment.TeacherAccountId, enrollment.SemesterId)'><i class="fas fa-user-minus"></i></button></div></td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                        <ListPager State="enrollmentPager" TotalCount="enrolled.Count" />
                    </article>
                }
            }
            else if (active == "classrooms")
            {
                <div class="page-intro list-intro">
                    <div class="split-intro">
                        <div><span>Each classroom gets a biometric scanner <code>deviceCode</code> (from the room name). ESP32 must send that code on every enroll/scan.</span></div>
                        <div class="intro-actions">
                            <button class="primary-button intro-add-button" @onclick="OpenAddClassroom"><i class="fas fa-plus"></i>Add classroom</button>
                            <select class="intro-filter" @bind="classroomFilter" @bind:after="ResetClassroomPage" aria-label="Filter classrooms">
                                <option value="all">All classrooms</option>
                                <option value="on">AC on</option>
                                <option value="off">AC off</option>
                                <option value="device">With device</option>
                                <option value="no-device">No device</option>
                            </select>
                        </div>
                    </div>
                    <label class="intro-search"><i class="fas fa-magnifying-glass"></i><input type="search" @bind="classroomSearch" @bind:event="oninput" @bind:after="ResetClassroomPage" placeholder="Search classrooms" aria-label="Search classrooms" /></label>
                </div>
                <article class="panel list-view">
                    <div class="data-table-wrap"><table class="data-table">
                        <thead><tr><th>Room</th><th>Capacity</th><th>Device code</th><th>Target temp</th><th>AC status</th><th>Actions</th></tr></thead>
                        <tbody>
                            @if (FilteredClassrooms.Count == 0) { <tr><td colspan="6">@(classrooms.Count == 0 ? "No classrooms have been created yet." : "No classrooms match this search or filter.")</td></tr> }
                            @foreach (var room in PagedClassrooms)
                            {
                                <tr>
                                    <td><strong>@room.Name</strong></td>
                                    <td>@room.Capacity</td>
                                    <td>@(DeviceCodeForRoom(room.Id) ?? "—")</td>
                                    <td>@room.TargetTemperature°C</td>
                                    <td><span class='status-badge @AcStatusBadge(room.AcStatus)'>@AcStatusLabel(room.AcStatus)</span></td>
                                    <td class="table-actions"><div class="table-action-group"><button type="button" class="table-action" title="Edit" aria-label="Edit classroom" @onclick='() => EditClassroom(room)'><i class="fas fa-pen"></i></button><button type="button" class="table-action danger" title="Remove" aria-label="Remove classroom" @onclick='() => OpenDelete("classroom", room.Id, room.Name)'><i class="fas fa-trash"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    <ListPager State="classroomPager" TotalCount="FilteredClassrooms.Count" />
                </article>
            }
            else if (active == "schedules")
            {
                <div class="page-intro list-intro">
                    <div class="split-intro">
                        <div><span>Teachers must be enrolled in the semester. Overlaps for the same teacher or classroom are rejected. Makeup sessions take priority when both are in window.</span></div>
                        <div class="intro-actions">
                            <button class="primary-button intro-add-button" @onclick="OpenAddSchedule"><i class="fas fa-plus"></i>Add schedule</button>
                            <select class="intro-filter" @bind="scheduleFilter" @bind:after="OnScheduleFilterChanged" aria-label="Filter schedules">
                                <option value="all">All schedules</option>
                                <option value="today">Today</option>
                                <option value="date">On date…</option>
                                <option value="upcoming">Upcoming</option>
                                <option value="past">Past</option>
                                <option value="regular">Regular</option>
                                <option value="makeup">Makeup</option>
                            </select>
                            @if (scheduleFilter == "date")
                            {
                                <label class="intro-date"><span class="visually-hidden">Schedule date</span><input type="date" @bind="scheduleFilterDate" @bind:after="ResetSchedulePage" aria-label="Choose schedule date" /></label>
                            }
                        </div>
                    </div>
                    <label class="intro-search"><i class="fas fa-magnifying-glass"></i><input type="search" @bind="scheduleSearch" @bind:event="oninput" @bind:after="ResetSchedulePage" placeholder="Search schedules" aria-label="Search schedules" /></label>
                </div>
                <article class="panel list-view">
                    <div class="data-table-wrap"><table class="data-table">
                        <thead><tr><th>Teacher</th><th>Semester</th><th>Kind</th><th>Classroom</th><th>Subject</th><th>Date</th><th>Time</th><th>Actions</th></tr></thead>
                        <tbody>
                            @if (FilteredSchedules.Count == 0) { <tr><td colspan="8">@(schedules.Count == 0 ? "No schedules have been stored yet." : "No schedules match this search or filter.")</td></tr> }
                            @foreach (var schedule in PagedSchedules)
                            {
                                <tr>
                                    <td><strong>@schedule.TeacherDisplayName</strong></td>
                                    <td>@(schedule.SemesterName ?? "—")</td>
                                    <td><span class='status-badge @(schedule.ScheduleKind == "Makeup" ? "pending" : "neutral")'>@schedule.ScheduleKind</span></td>
                                    <td>@schedule.ClassroomName</td>
                                    <td>@schedule.SubjectName</td>
                                    <td>@schedule.ScheduleDate.ToString("MMM d, yyyy")</td>
                                    <td>@schedule.StartTime.ToString("HH:mm") – @schedule.EndTime.ToString("HH:mm")</td>
                                    <td class="table-actions"><div class="table-action-group"><button type="button" class="table-action" title="Move" aria-label="Move schedule" @onclick='() => OpenMoveSchedule(schedule)'><i class="fas fa-calendar-day"></i></button><button type="button" class="table-action danger" title="Delete" aria-label="Delete schedule" @onclick='() => OpenDelete("schedule", schedule.Id, $"{schedule.SubjectName} · {schedule.ClassroomName}")'><i class="fas fa-trash"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    <ListPager State="schedulePager" TotalCount="FilteredSchedules.Count" />
                </article>
            }
            else if (active == "temperature")
            {
                <div class="page-intro"><span>Toggle AC on each room row. Devices poll room status about every 30 seconds and apply the command.</span></div>
                <article class="panel">
                    <div class="panel-heading"><div><span class="eyebrow">ROOM STATUS</span><h3>All classrooms</h3></div></div>
                    <div class="data-table-wrap"><table class="data-table">
                        <thead><tr><th>Classroom</th><th>Device</th><th>Target</th><th>AC status</th><th>Actions</th></tr></thead>
                        <tbody>
                            @if (classrooms.Count == 0) { <tr><td colspan="5">Add a classroom before sending AC commands.</td></tr> }
                            @foreach (var room in PagedAcRooms)
                            {
                                var acOn = AcIsOn(room.AcStatus);
                                <tr>
                                    <td><strong>@room.Name</strong></td>
                                    <td>@(DeviceCodeForRoom(room.Id) ?? "—")</td>
                                    <td>@room.TargetTemperature°C</td>
                                    <td><span class='status-badge @AcStatusBadge(room.AcStatus)'>@AcStatusLabel(room.AcStatus)</span></td>
                                    <td class="table-actions">
                                        <div class="table-action-group">
                                            <button type="button" class='table-action @(acOn ? "danger" : string.Empty)' title="@(acOn ? "Turn AC off" : "Turn AC on")" aria-label="@(acOn ? $"Turn off AC for {room.Name}" : $"Turn on AC for {room.Name}")" @onclick='() => RemoteAc(room.Id, !acOn)'><i class='fas @(acOn ? "fa-toggle-off" : "fa-toggle-on")'></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    <ListPager State="acRoomPager" TotalCount="classrooms.Count" />
                </article>
                <article class="panel"><div class="panel-heading"><div><span class="eyebrow">COMMAND LOG</span><h3>Recent temperature events</h3></div></div><div class="data-table-wrap"><table class="data-table"><thead><tr><th>Classroom</th><th>Event</th><th>Target</th><th>Recorded</th></tr></thead><tbody>@if (temperatureLogs.Count == 0) { <tr><td colspan="4">No temperature commands have been logged.</td></tr> } @foreach (var log in PagedTemperatureLogs) { <tr><td>@log.ClassroomName</td><td>@log.EventType</td><td>@(log.TargetTemperature is null ? "—" : $"{log.TargetTemperature}°C")</td><td>@SchoolClock.Format(log.RecordedAt, "MMM d HH:mm")</td></tr> }</tbody></table></div><ListPager State="temperatureLogPager" TotalCount="temperatureLogs.Count" /></article>
            }
            else if (active == "attendance")
            {
                <div class="page-intro"><span>Outcomes are derived from punches vs the schedule window: On time, Late, Absent, or Missing time-out.</span></div>
                <article class="panel"><div class="data-table-wrap"><table class="data-table"><thead><tr><th>Teacher</th><th>Classroom</th><th>Time in</th><th>Time out</th><th>Verification</th><th>Outcome</th></tr></thead><tbody>@if (attendance.Count == 0) { <tr><td colspan="6">No attendance logs have been recorded.</td></tr> } @foreach (var item in PagedAttendance) { <tr><td><strong>@item.TeacherDisplayName</strong></td><td>@item.ClassroomName</td><td>@(item.Outcome == AttendanceOutcomes.Absent ? "—" : SchoolClock.Format(item.TimeIn, "MMM d HH:mm"))</td><td>@(item.Outcome == AttendanceOutcomes.Absent ? "—" : SchoolClock.Format(item.TimeOut, "MMM d HH:mm"))</td><td>@item.VerificationMethod</td><td><span class='status-badge @AttendanceOutcomes.BadgeClass(item.Outcome, item.Status)'>@AttendanceOutcomes.Display(item.Outcome, item.Status)</span></td></tr> }</tbody></table></div><ListPager State="attendancePager" TotalCount="attendance.Count" /></article>
            }
            else
            {
                <div class="settings-grid">
                    <article class="panel settings-panel">
                        <div class="settings-panel-body">
                            <span class="eyebrow">ADMIN CREDENTIALS</span>
                            <h3>Account contact</h3>
                            <div class="form-stack">
                                <label>Current password<input type="password" @bind="adminCurrentPassword" autocomplete="current-password" /></label>
                                <label>Registered admin email<input type="email" @bind="adminEmail" /></label>
                                <label>New password<input type="password" @bind="adminNewPassword" placeholder="Leave blank to keep current password" autocomplete="new-password" /></label>
                            </div>
                        </div>
                        <button class="primary-button" @onclick="SaveAdminSettings">Save settings</button>
                    </article>
                    <article class="panel settings-panel">
                        <div class="settings-panel-body">
                            <span class="eyebrow">FINGERPRINT DEVICES</span>
                            <h3>Clear sensor fingerprints</h3>
                            <p class="form-help">Deletes all enrolled fingerprint templates in MariaDB and queues every active scanner to wipe its sensor flash on the next status poll (~30s). Teachers must re-enroll on the device afterward.</p>
                            <p class="form-help"><strong>@fingerprintTemplateCount</strong> template(s) currently stored · <strong>@biometricDevices.Count(device => device.IsActive)</strong> active scanner(s)</p>
                        </div>
                        <button class="danger-outline-button" @onclick='() => clearFingerprintsOpen = true'>Clear fingerprint device data</button>
                    </article>
                    <article class="panel settings-panel">
                        <div class="settings-panel-body">
                            <span class="eyebrow">FRESH START</span>
                            <h3>Reset system to first access</h3>
                            <p class="form-help">This permanently clears teachers, classrooms, schedules, attendance, and temperature logs; then it creates the configured default administrator with no email.</p>
                        </div>
                        <button class="danger-button" @onclick='() => resetOpen = true'>Reset all system data</button>
                    </article>
                </div>
            }
        </section>
    </main>
