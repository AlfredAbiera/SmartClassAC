    private async Task RemoteAc(long classroomId, bool turnOn)
    {
        var room = classrooms.FirstOrDefault(item => item.Id == classroomId);
        if (room is null)
        {
            Toast("Classroom was not found.");
            return;
        }

        var eventType = turnOn ? "RemoteOn" : "RemoteOff";
        var result = await AuthService.SetTemperatureAsync(new SetTemperatureRequest(classroomId, room.TargetTemperature, eventType));
        if (!result.Succeeded) { Toast(result.Error ?? "Temperature command could not be saved."); return; }
        await ReloadAsync();
        Toast(turnOn
            ? "Remote AC on queued — the room scanner applies it within about 30 seconds."
            : "Remote AC off queued — the room scanner applies it within about 30 seconds.");
    }

