    private async Task BlockFingerprintSlot()
    {
        if (fingerprintSlotToBlock is not long slot) { Toast("Enter a sensor slot number."); return; }
        try
        {
            var result = await AuthService.SetFingerprintSlotBlockedAsync(slot, true);
            if (!result.Succeeded) { Toast(result.Error ?? "The slot could not be blocked."); return; }
            blockedSlotsLoaded = false;
            inspectedFingerprintSlot = null;
            Toast($"Fingerprint slot {slot} is blocked for attendance.");
        }
        catch (MySqlConnector.MySqlException exception)
        {
            Logger.LogError(exception, "Could not block fingerprint slot {Slot}.", slot);
            Toast("Could not block the slot. Check the database and migration 016.");
        }
    }

    private async Task InspectFingerprintSlot()
    {
        inspectedFingerprintSlot = null;
        if (fingerprintSlotToBlock is not long slot || slot <= 0 || slot > ushort.MaxValue)
        {
            Toast("Enter a sensor slot between 1 and 65535.");
            return;
        }
        try
        {
            inspectedFingerprintSlot = await AuthService.InspectFingerprintSlotAsync(slot);
        }
        catch (MySqlConnector.MySqlException exception)
        {
            Logger.LogError(exception, "Could not inspect fingerprint slot {Slot}.", slot);
            Toast("Could not inspect the slot. Check the database and migration 016.");
