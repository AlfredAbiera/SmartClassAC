    private TimeOnly scheduleStartTime = new(8, 0), scheduleEndTime = new(9, 30), moveScheduleStartTime = new(8, 0), moveScheduleEndTime = new(9, 30);
    private ScheduleDirectoryEntry? moveScheduleTarget;
    private readonly HashSet<DayOfWeek> scheduleCustomDays = new();
    private static readonly (DayOfWeek Day, string Label)[] ScheduleWeekdayChoices =
    {
        (DayOfWeek.Monday, "Mon"),
        (DayOfWeek.Tuesday, "Tue"),
        (DayOfWeek.Wednesday, "Wed"),
        (DayOfWeek.Thursday, "Thu"),
        (DayOfWeek.Friday, "Fri")
    };
    private readonly ListPageState teacherPager = new();
    private readonly ListPageState semesterPager = new();
    private readonly ListPageState enrollmentPager = new();
    private readonly ListPageState classroomPager = new();
    private readonly ListPageState schedulePager = new();
    private readonly ListPageState acRoomPager = new();
    private readonly ListPageState temperatureLogPager = new();
    private readonly ListPageState attendancePager = new();
    private AuthenticatedUser? currentUser;
    private List<TeacherDirectoryEntry> teachers = new();
    private List<ClassroomEntry> classrooms = new();
    private List<ScheduleDirectoryEntry> schedules = new();
    private List<SemesterEntry> semesters = new();
    private List<TeacherSemesterEntry> teacherSemesters = new();
    private List<BiometricDeviceEntry> biometricDevices = new();
    private List<AttendanceLogEntry> attendance = new();
    private List<TemperatureLogEntry> temperatureLogs = new();
    private CancellationTokenSource? liveRefreshCts;

    private DateOnly Today => SchoolClock.Today(SchoolTime.Value);
    private string AdminName => currentUser?.DisplayName ?? "Administrator";
    private string AdminInitials => Initials(AdminName);
    private static string Initials(string name) => string.Concat((name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(word => char.ToUpperInvariant(word[0])));
    private string Title => active switch { "teachers" => "Teacher management", "semesters" => "Semester management", "classrooms" => "Classroom management", "schedules" => "Schedule management", "temperature" => "AC control", "attendance" => "Attendance logs", "settings" => "System settings", _ => "Dashboard overview" };
    private string NavClass(string section) => $"sc-nav-item {(active == section ? "active" : string.Empty)}";
    private IEnumerable<TeacherDirectoryEntry> TeachersForSelectedSemester =>
        (scheduleSemesterId <= 0
            ? teachers
            : teachers.Where(teacher => teacherSemesters.Any(item => item.SemesterId == scheduleSemesterId && item.TeacherAccountId == teacher.Id)))
        .Where(teacher => teacher.IsActive);
    private SemesterEntry? SelectedScheduleSemester => semesters.FirstOrDefault(item => item.Id == scheduleSemesterId);
    private SemesterEntry? MoveScheduleSemester =>
        moveScheduleTarget?.SemesterId is long semesterId
            ? semesters.FirstOrDefault(item => item.Id == semesterId)
            : null;
    private IReadOnlyList<DateOnly> SchedulePreviewDates
    {
        get
        {
            var semester = SelectedScheduleSemester;
            if (semester is null)
            {
                return Array.Empty<DateOnly>();
            }

            var start = DateOnly.FromDateTime(scheduleDate);
            return ScheduleRecurrence.ExpandDates(start, semester.EndDate, scheduleRecurrence, scheduleCustomDays.ToList());
        }
    }
    private int SchedulePreviewCount => SchedulePreviewDates.Count;
    private string SchedulePreviewText
    {
        get
        {
            var semester = SelectedScheduleSemester;
            if (semester is null)
            {
                return "Select a semester to preview repeating dates through semester end.";
            }

            var dates = SchedulePreviewDates;
            if (dates.Count == 0)
            {
                return scheduleRecurrence == ScheduleRecurrence.Custom
                    ? "Select at least one weekday to generate schedules through semester end."
                    : "No dates fall between the start date and the semester end.";
            }

            var patternLabel = ScheduleRecurrence.Describe(scheduleRecurrence, DateOnly.FromDateTime(scheduleDate), scheduleCustomDays.ToList());
            return dates.Count == 1
                ? $"Creates 1 class on {dates[0]:MMM d, yyyy}."
                : $"Creates {dates.Count} classes · {patternLabel} · {dates[0]:MMM d} – {dates[^1]:MMM d, yyyy} (through semester end {semester.EndDate:MMM d, yyyy}).";
        }
    }
    private IReadOnlyList<TeacherDirectoryEntry> FilteredTeachers
    {
        get
        {
            IEnumerable<TeacherDirectoryEntry> query = teacherFilter switch
            {
                "active" => teachers.Where(teacher => teacher.IsActive),
                "inactive" => teachers.Where(teacher => !teacher.IsActive),
                "prints" => teachers.Where(teacher => teacher.FingerprintTemplateCount > 0),
                "no-prints" => teachers.Where(teacher => teacher.FingerprintTemplateCount == 0),
                "scheduled" => teachers.Where(teacher => schedules.Any(schedule => schedule.TeacherAccountId == teacher.Id && schedule.ScheduleDate == Today)),
                "unscheduled" => teachers.Where(teacher => schedules.All(schedule => schedule.TeacherAccountId != teacher.Id || schedule.ScheduleDate != Today)),
                _ => teachers
            };
            var term = teacherSearch.Trim();
            if (term.Length > 0)
            {
                query = query.Where(teacher =>
                    ContainsIgnoreCase(teacher.DisplayName, term) ||
                    ContainsIgnoreCase(teacher.Username, term) ||
                    ContainsIgnoreCase(teacher.Email, term) ||
                    ContainsIgnoreCase(teacher.Phone, term) ||
                    ContainsIgnoreCase(teacher.EmployeeNumber, term) ||
                    ContainsIgnoreCase(teacher.IsActive ? "Active" : "Inactive", term) ||
                    ContainsIgnoreCase(ScheduleTodayFor(teacher.Id), term));
            }

            return query.ToList();
        }
    }
    private IReadOnlyList<TeacherDirectoryEntry> PagedTeachers => teacherPager.Slice(FilteredTeachers);
    private IReadOnlyList<SemesterEntry> FilteredSemesters
    {
        get
        {
            IEnumerable<SemesterEntry> query = semesterFilter switch
            {
                "active" => semesters.Where(semester => semester.IsActive),
                "inactive" => semesters.Where(semester => !semester.IsActive),
                _ => semesters
            };
            var term = semesterSearch.Trim();
            if (term.Length > 0)
            {
                query = query.Where(semester =>
                    ContainsIgnoreCase(semester.Name, term) ||
                    ContainsIgnoreCase(semester.StartDate.ToString("MMM d, yyyy"), term) ||
                    ContainsIgnoreCase(semester.EndDate.ToString("MMM d, yyyy"), term) ||
                    ContainsIgnoreCase(semester.IsActive ? "Active" : "Inactive", term));
            }

            return query.ToList();
        }
    }
    private IReadOnlyList<SemesterEntry> PagedSemesters => semesterPager.Slice(FilteredSemesters);
    private IReadOnlyList<ClassroomEntry> FilteredClassrooms
    {
        get
        {
            IEnumerable<ClassroomEntry> query = classroomFilter switch
            {
                "on" => classrooms.Where(room => AcIsOn(room.AcStatus)),
                "off" => classrooms.Where(room => !AcIsOn(room.AcStatus)),
                "device" => classrooms.Where(room => DeviceCodeForRoom(room.Id) is not null),
                "no-device" => classrooms.Where(room => DeviceCodeForRoom(room.Id) is null),
                _ => classrooms
            };
            var term = classroomSearch.Trim();
            if (term.Length > 0)
            {
                query = query.Where(room =>
                    ContainsIgnoreCase(room.Name, term) ||
                    ContainsIgnoreCase(DeviceCodeForRoom(room.Id), term) ||
                    ContainsIgnoreCase(AcStatusLabel(room.AcStatus), term) ||
                    ContainsIgnoreCase(room.Capacity.ToString(), term) ||
                    ContainsIgnoreCase($"{room.TargetTemperature}", term));
            }

            return query.ToList();
        }
    }
    private IReadOnlyList<ClassroomEntry> PagedClassrooms => classroomPager.Slice(FilteredClassrooms);
    private IReadOnlyList<ScheduleDirectoryEntry> FilteredSchedules
    {
        get
        {
            IEnumerable<ScheduleDirectoryEntry> query = scheduleFilter switch
            {
                "today" => schedules.Where(schedule => schedule.ScheduleDate == Today),
                "date" => schedules.Where(schedule => schedule.ScheduleDate == DateOnly.FromDateTime(scheduleFilterDate)),
                "upcoming" => schedules.Where(schedule => schedule.ScheduleDate > Today),
                "past" => schedules.Where(schedule => schedule.ScheduleDate < Today),
                "regular" => schedules.Where(schedule => schedule.ScheduleKind == ScheduleKinds.Regular),
                "makeup" => schedules.Where(schedule => schedule.ScheduleKind == ScheduleKinds.Makeup),
                _ => schedules
            };
            var term = scheduleSearch.Trim();
            if (term.Length > 0)
            {
                query = query.Where(schedule =>
                    ContainsIgnoreCase(schedule.TeacherDisplayName, term) ||
                    ContainsIgnoreCase(schedule.SemesterName, term) ||
                    ContainsIgnoreCase(schedule.ScheduleKind, term) ||
                    ContainsIgnoreCase(schedule.ClassroomName, term) ||
                    ContainsIgnoreCase(schedule.SubjectName, term) ||
                    ContainsIgnoreCase(schedule.ScheduleDate.ToString("MMM d, yyyy"), term) ||
                    ContainsIgnoreCase($"{schedule.StartTime:HH\\:mm} – {schedule.EndTime:HH\\:mm}", term));
            }

            return query.ToList();
        }
    }
    private IReadOnlyList<ScheduleDirectoryEntry> PagedSchedules => schedulePager.Slice(FilteredSchedules);
    private IReadOnlyList<ClassroomEntry> PagedAcRooms => acRoomPager.Slice(classrooms);
    private IReadOnlyList<TemperatureLogEntry> PagedTemperatureLogs => temperatureLogPager.Slice(temperatureLogs);
    private IReadOnlyList<AttendanceLogEntry> PagedAttendance => attendancePager.Slice(attendance);
    private static bool ContainsIgnoreCase(string? value, string term) =>
        !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    private string? DeviceCodeForRoom(long classroomId) =>
        biometricDevices.FirstOrDefault(device => device.ClassroomId == classroomId)?.DeviceCode;
    private static bool AcIsOn(string status) => status is "Cooling" or "Override" or "Remote";
    private static string AcStatusTone(string status) => AcIsOn(status) ? "online" : "idle";
