    private async Task ClearFingerprintDevices()
    {
        if (!string.Equals(clearFingerprintsConfirmation, "CLEAR", StringComparison.Ordinal)) { Toast("Type CLEAR to confirm fingerprint wipe."); return; }
        var result = await AuthService.RequestClearAllFingerprintDevicesAsync();
        if (!result.Succeeded) { Toast(result.Error ?? "Fingerprint data could not be cleared."); return; }
        clearFingerprintsOpen = false;
        clearFingerprintsConfirmation = string.Empty;
        await ReloadAsync();
        Toast("Fingerprint templates cleared. Active scanners will wipe their sensors on the next status poll.");
    }

    private async Task ResetSystem()
    {
        if (!string.Equals(resetConfirmation, "RESET", StringComparison.Ordinal)) { Toast("Type RESET to confirm the fresh-start reset."); return; }
        var result = await AuthService.ResetSystemToFirstAccessAsync(adminCurrentPassword);
        if (!result.Succeeded) { Toast(result.Error ?? "System could not be reset."); return; }
        adminCurrentPassword = string.Empty;
        await AuthStateProvider.NotifyUserLogoutAsync();
        Navigation.NavigateTo("/auth/logout?returnUrl=%2Ffirst-access", true);
    }
