    private async Task DeleteTarget()
    {
        if (!string.Equals(deleteConfirmation, "DELETE", StringComparison.Ordinal)) { Toast("Type DELETE to confirm removal."); return; }
        var type = deleteTargetType;
        var result = type switch
        {
            "teacher" => await AuthService.DeleteTeacherAsync(deleteTargetId),
            "classroom" => await AuthService.DeleteClassroomAsync(deleteTargetId),
            "schedule" => await AuthService.DeleteScheduleAsync(deleteTargetId),
            _ => OperationResult.Failure("No item was selected for removal.")
        };
        if (!result.Succeeded) { Toast(result.Error ?? "Item could not be removed."); return; }
        CloseDelete();
        await ReloadAsync();
        Toast(type == "schedule" ? "Schedule deleted." : $"{type} removed from active use.");
    }

    private async Task SaveSchedule()
    {
        var result = await AuthService.CreateSchedulesAsync(new CreateScheduleRequest(
            scheduleTeacherId,
            scheduleClassroomId,
            scheduleSemesterId,
            scheduleKind,
            scheduleSubject,
            DateOnly.FromDateTime(scheduleDate),
            scheduleStartTime,
            scheduleEndTime,
            scheduleRecurrence,
            scheduleRecurrence == ScheduleRecurrence.Custom ? scheduleCustomDays.ToList() : null));
        if (!result.Succeeded) { Toast(result.Error ?? "Schedule could not be saved."); return; }
        CloseScheduleModal();
        await ReloadAsync();
        Toast(result.Summary);
    }

