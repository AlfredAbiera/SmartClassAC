    private void SelectReplacement(TeacherFingerprint fingerprint, BiometricDeviceEntry scanner)
    {
        replacementSelection = fingerprint;
        replacementDevice = scanner;
        replacementConfirmed = false;
    }

    private async Task PrepareReplacement()
    {
        if (preparingEnrollment || !replacementConfirmed || fingerprintTeacher is null ||
            replacementSelection is null || replacementDevice is null) return;
        preparingEnrollment = true;
        try
        {
            var result = await AuthService.PrepareFingerprintReplacementAsync(
                replacementDevice.Id, fingerprintTeacher.Id, replacementSelection.FingerPosition, replacementSelection.Slot);
            if (!result.Succeeded) { Toast(result.Error ?? "Could not prepare replacement."); return; }
            replacementSelection = null;
            replacementDevice = null;
            replacementConfirmed = false;
            blockedSlotsLoaded = false;
            if (await LoadEnrollmentPreparations())
                Toast("Replacement prepared and slot blocked. Select the preparation and record consent.");
            else
                Toast("Replacement prepared, but preparations could not be reloaded. Refresh before trying again.");
        }
        catch (MySqlConnector.MySqlException exception)
        {
            Logger.LogError(exception, "Could not prepare fingerprint replacement.");
            Toast("Could not prepare replacement. Check the database.");
        }
        finally { preparingEnrollment = false; }
    }

    private async Task<bool> LoadEnrollmentPreparations()
    {
        try
        {
            enrollmentPreparations = await AuthService.GetFingerprintEnrollmentPreparationsAsync();
            preparationsLoaded = true;
            return true;
        }
        catch (MySqlConnector.MySqlException exception)
        {
            Logger.LogError(exception, "Could not load fingerprint enrollment preparations.");
            Toast("Could not load preparations. Check the database and migrations 017 and 019.");
            return false;
        }
    }

    private async Task PrepareEnrollment()
    {
        if (preparingEnrollment) return;
        if (preparationTeacherId is not long teacherId || !FingerprintSlots.IsValid(preparationFinger))
        {
            Toast("Select a teacher and finger.");
            return;
        }
        preparingEnrollment = true;
        try
        {
            var result = await AuthService.PrepareFingerprintEnrollmentAutomaticallyAsync(teacherId, preparationFinger);
            if (!result.Succeeded) { Toast(result.Error ?? "Could not prepare enrollment."); return; }
            blockedSlotsLoaded = false;
            inspectedFingerprintSlot = null;
            if (await LoadEnrollmentPreparations())
                Toast("Slot reserved and blocked. Select the preparation and record consent before starting enrollment.");
            else
                Toast("Slot reserved, but preparations could not be reloaded. Refresh before trying again.");
        }
        catch (MySqlConnector.MySqlException exception)
        {
            Logger.LogError(exception, "Could not prepare fingerprint enrollment.");
            Toast("Could not prepare enrollment. Check the database and migrations 017 and 024.");
        }
        finally { preparingEnrollment = false; }
    }

