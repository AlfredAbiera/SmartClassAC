    private async Task SaveDevice()
    {
        var isNewDevice = editingDeviceId == 0;
        var result = editingDeviceId == 0
            ? await AuthService.CreateBiometricDeviceAsync(new CreateBiometricDeviceRequest(
                deviceClassroomId,
                deviceTargetTemperature,
                devicePollingIntervalSeconds,
                deviceIsActive,
                deviceFingerprintEnrollmentEnabled,
                deviceAttendanceScanEnabled))
            : await AuthService.UpdateBiometricDeviceAsync(new UpdateBiometricDeviceRequest(
                editingDeviceId,
                deviceClassroomId,
                deviceTargetTemperature,
                devicePollingIntervalSeconds,
                deviceIsActive,
                deviceFingerprintEnrollmentEnabled,
                deviceAttendanceScanEnabled));
        if (!result.Succeeded)
        {
            Toast(result.Error ?? "Device settings could not be saved.");
            return;
        }

        CloseDeviceModal();
        await ReloadAsync();
        Toast(isNewDevice
            ? "Device registered. Enter the pairing code shown in the list on the device (admin menu → Pair device)."
            : "Device settings saved. The device will receive updates on its next status request.");
    }

