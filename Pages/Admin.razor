    private async Task ChangeEnrollmentScanner(ChangeEventArgs args)
    {
        if (!long.TryParse(args.Value?.ToString(), out var id) || id < 0)
        {
            Toast("Select a valid enrollment scanner.");
            return;
        }

        var result = await AuthService.SetEnrollmentScannerAsync(id == 0 ? null : id);
        if (!result.Succeeded)
        {
            Toast(result.Error ?? "Enrollment scanner could not be updated.");
            await ReloadAsync();
            return;
