    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        liveRefreshCts = new CancellationTokenSource();
        _ = RunLiveRefreshLoopAsync(liveRefreshCts.Token);
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        try
        {
            currentUser = await AuthService.GetCurrentUserAsync();
            adminEmail = currentUser?.Email ?? string.Empty;
            var teachersTask = AuthService.GetTeachersAsync();
            var classroomsTask = AuthService.GetClassroomsAsync();
            var schedulesTask = AuthService.GetSchedulesAsync();
            var semestersTask = AuthService.GetSemestersAsync();
            var teacherSemestersTask = AuthService.GetTeacherSemestersAsync();
            var devicesTask = AuthService.GetBiometricDevicesAsync();
            var attendanceTask = AuthService.GetAttendanceLogsAsync();
            var temperatureLogsTask = AuthService.GetTemperatureLogsAsync();
            var fingerprintCountTask = AuthService.CountFingerprintTemplatesAsync();
            await Task.WhenAll(teachersTask, classroomsTask, schedulesTask, semestersTask, teacherSemestersTask, devicesTask, attendanceTask, temperatureLogsTask, fingerprintCountTask);
            teachers = (await teachersTask).ToList();
            classrooms = (await classroomsTask).ToList();
            schedules = (await schedulesTask).ToList();
            semesters = (await semestersTask).ToList();
            teacherSemesters = (await teacherSemestersTask).ToList();
            biometricDevices = (await devicesTask).ToList();
            attendance = (await attendanceTask).ToList();
            temperatureLogs = (await temperatureLogsTask).ToList();
            fingerprintTemplateCount = await fingerprintCountTask;
            irSnapshots = await IrAdministration.GetAsync();
            irStatusUnavailable = false;
            hasAdminDevicePin = await AuthService.HasAdminDevicePinAsync();
            if (scheduleSemesterId == 0)
            {
                scheduleSemesterId = semesters.FirstOrDefault(item => item.IsActive)?.Id ?? 0;
            }
        }
        catch (Exception exception) { Logger.LogError(exception, "Admin records could not be loaded."); irSnapshots = Array.Empty<AcIrAdminSnapshot>(); irStatusUnavailable = true; Toast("Records could not be loaded."); }
        finally { isLoading = false; }
    }

    private async Task RefreshLiveStateAsync()
    {
        try
        {
            var classroomsTask = AuthService.GetClassroomsAsync();
            var attendanceTask = AuthService.GetAttendanceLogsAsync();
            var temperatureLogsTask = AuthService.GetTemperatureLogsAsync();
            var devicesTask = active is "devices" or "overview" ? AuthService.GetBiometricDevicesAsync() : null;
            await Task.WhenAll(classroomsTask, attendanceTask, temperatureLogsTask);
            classrooms = (await classroomsTask).ToList();
            attendance = (await attendanceTask).ToList();
            temperatureLogs = (await temperatureLogsTask).ToList();
            if (devicesTask is not null)
            {
                biometricDevices = (await devicesTask).ToList();
            }
            if (active == "temperature")
            {
                irSnapshots = await IrAdministration.GetAsync();
                irStatusUnavailable = false;
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Admin live state refresh failed.");
            irSnapshots = Array.Empty<AcIrAdminSnapshot>();
            irStatusUnavailable = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RunLiveRefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (active is "overview" or "classrooms" or "temperature" or "attendance")
                {
                    await RefreshLiveStateAsync();
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

