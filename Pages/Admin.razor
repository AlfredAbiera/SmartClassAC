@page "/admin"
@using Microsoft.Extensions.Options
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject CustomAuthStateProvider AuthStateProvider
@inject IOptions<SchoolTimeOptions> SchoolTime
@inject ILogger<Admin> Logger
@inject IConfiguration Configuration
@inject GsmModemSettingsStore GsmSettings
@inject GsmSmsTransport GsmTransport
@inject BuzzerSettingsStore BuzzerSettings
@inject AcIrAdministration IrAdministration
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Admin Dashboard | SmartClass AC</PageTitle>

<div class="dashboard-page admin-dashboard">
    <aside class='dashboard-sidebar @(sidebarOpen ? "is-open" : string.Empty)'>
        <a class="dashboard-brand" href="/"><span class="brand-mark"><i class="fas fa-snowflake"></i></span><span>SmartClass <strong>AC</strong></span></a>
        <p class="workspace-label">ADMINISTRATOR WORKSPACE</p>
        <nav class="dashboard-nav" aria-label="Admin dashboard">
            <button class='@NavClass("overview")' @onclick='() => Navigate("overview")'><i class="fas fa-gauge-high"></i>Overview</button>
            <p class="nav-group-label">MANAGEMENT</p>
            <button class='@NavClass("teachers")' @onclick='() => Navigate("teachers")'><i class="fas fa-users"></i>Teachers</button>
            <button class='@NavClass("semesters")' @onclick='() => Navigate("semesters")'><i class="fas fa-layer-group"></i>Semesters</button>
            <button class='@NavClass("classrooms")' @onclick='() => Navigate("classrooms")'><i class="fas fa-door-open"></i>Classrooms</button>
            <button class='@NavClass("devices")' @onclick='() => Navigate("devices")'><i class="fas fa-fingerprint"></i>Devices</button>
            <button class='@NavClass("schedules")' @onclick='() => Navigate("schedules")'><i class="fas fa-calendar-days"></i>Schedules</button>
            <p class="nav-group-label">OPERATIONS</p>
            <button class='@NavClass("temperature")' @onclick='() => Navigate("temperature")'><i class="fas fa-temperature-half"></i>AC control</button>
            <button class='@NavClass("attendance")' @onclick='() => Navigate("attendance")'><i class="fas fa-clipboard-check"></i>Attendance</button>
            <p class="nav-group-label">SYSTEM</p>
            <button class='@NavClass("gsm")' @onclick='() => Navigate("gsm")'><i class="fas fa-sim-card"></i>GSM settings</button>
            <button class='@NavClass("buzzer")' @onclick='() => Navigate("buzzer")'><i class="fas fa-bell"></i>Buzzer settings</button>
            <button class='@NavClass("settings")' @onclick='() => Navigate("settings")'><i class="fas fa-gear"></i>System settings</button>
        </nav>
        <button class="sidebar-logout" @onclick="Logout"><i class="fas fa-arrow-right-from-bracket"></i>Log out</button>
    </aside>
    @if (sidebarOpen) { <button class="sidebar-scrim" aria-label="Close navigation" @onclick="ToggleSidebar"></button> }

    <main class="dashboard-main">
        <header class="dashboard-topbar"><button class="icon-button mobile-nav-toggle" aria-label="Open navigation" @onclick="ToggleSidebar"><i class="fas fa-bars"></i></button><div class="topbar-title"><span class="eyebrow">SMARTCLASS AC / ADMIN</span><h1>@Title</h1></div><div class="topbar-actions"><button class="profile-chip" @onclick='() => Navigate("settings")'><span>@AdminInitials</span><strong>@AdminName</strong><i class="fas fa-chevron-down"></i></button></div></header>
        <section class="dashboard-content">
            <AutoDismiss Active="@(!string.IsNullOrEmpty(message))" Version="@messageVersion" Dismissed="DismissMessage">
                <div class="dashboard-toast" role="status"><i class="fas fa-circle-check"></i>@message<button @onclick='() => message = string.Empty' aria-label="Dismiss"><i class="fas fa-xmark"></i></button></div>
            </AutoDismiss>
            @if (isLoading) { <article class="panel"><p class="form-help">Loading records…</p></article> }
            else if (active == "overview")
            {
                <div class="metric-grid admin-metric-grid">
                    <article class="metric-card blue"><span class="metric-icon"><i class="fas fa-person-chalkboard"></i></span><div><small>TEACHER ACCOUNTS</small><strong>@teachers.Count(teacher => teacher.IsActive)</strong><p>Active biometric teachers</p></div></article>
                    <article class="metric-card violet"><span class="metric-icon"><i class="fas fa-door-open"></i></span><div><small>CLASSROOMS</small><strong>@classrooms.Count</strong><p>Connected room records</p></div></article>
                    <article class="metric-card blue"><span class="metric-icon"><i class="fas fa-fingerprint"></i></span><div><small>DEVICES</small><strong>@biometricDevices.Count</strong><p>@biometricDevices.Count(device => device.IsActive) active devices</p></div></article>
                    <article class="metric-card teal"><span class="metric-icon"><i class="fas fa-calendar-days"></i></span><div><small>SCHEDULES TODAY</small><strong>@schedules.Count(schedule => schedule.ScheduleDate == Today)</strong><p>Conflict protected</p></div></article>
                    <article class="metric-card amber"><span class="metric-icon"><i class="fas fa-clipboard-check"></i></span><div><small>ATTENDANCE TODAY</small><strong>@attendance.Count(item => DateOnly.FromDateTime(item.TimeIn) == Today)</strong><p>Time-in records</p></div></article>
                </div>
                <div class="dashboard-grid overview-grid"><article class="panel live-panel"><div class="panel-heading"><div><span class="eyebrow">SAVED TARGETS</span><h3>Classroom climate</h3></div><button class="text-button" @onclick='() => Navigate("temperature")'>View all <i class="fas fa-arrow-right"></i></button></div><div class="room-climate-list">@if (classrooms.Count == 0) { <p class="form-help">Add classrooms before creating schedules.</p> } @foreach (var room in classrooms.Take(4)) { <div class="room-climate-row"><span class="room-avatar"><i class="fas fa-building"></i></span><div><strong>@room.Name</strong><small>@room.Capacity seats · Target</small></div><span class="mini-temp"><i class="fas fa-temperature-half"></i>@room.TargetTemperature°C</span><span class='room-status @AcStatusTone(room.AcStatus)'>@AcStatusLabel(room.AcStatus)</span></div> }</div></article><article class="panel attendance-panel"><div class="panel-heading"><div><span class="eyebrow">AUTOMATED LOGS</span><h3>Today's attendance</h3></div><button class="text-button" @onclick='() => Navigate("attendance")'>View all <i class="fas fa-arrow-right"></i></button></div><div class="attendance-ring"><div><strong>@attendance.Count(item => DateOnly.FromDateTime(item.TimeIn) == Today)</strong><small>time-ins</small></div></div><p class="form-help">Class start and end operations write the attendance log.</p></article></div>
            }
            else if (active == "teachers")
            {
                <div class="page-intro list-intro">
                    <div class="management-filters">
                            <label class="intro-search"><i class="fas fa-magnifying-glass" aria-hidden="true"></i><input type="search" @bind="teacherSearch" @bind:event="oninput" @bind:after="ResetTeacherPage" placeholder="Search teachers" aria-label="Search teachers" /></label>
                            <select class="intro-filter" @bind="teacherFilter" @bind:after="ResetTeacherPage" aria-label="Filter teachers">
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                                <option value="all">All teachers</option>
                                <option value="prints">With fingerprints</option>
                                <option value="no-prints">Without fingerprints</option>
                                <option value="scheduled">Scheduled today</option>
                                <option value="unscheduled">No schedule today</option>
                            </select>
                    </div>
                </div>
                <article class="panel list-view">
                    <div class="data-table-wrap"><table class="data-table">
                        <thead><tr><th>Teacher</th><th>Employee #</th><th>Mobile</th><th>Email</th><th>Fingerprints</th><th>Status</th><th>Schedule today</th><th>Actions</th></tr></thead>
                        <tbody>
                            @if (FilteredTeachers.Count == 0) { <tr><td colspan="8">@(teachers.Count == 0 ? "No teacher accounts have been created yet." : "No teachers match this search or filter.")</td></tr> }
                            @foreach (var teacher in PagedTeachers)
                            {
                                <tr>
                                    <td><div class="table-person"><span class="table-avatar">@Initials(teacher.DisplayName)</span><div><strong>@teacher.DisplayName</strong><small>@teacher.Username</small></div></div></td>
                                    <td>@(teacher.EmployeeNumber ?? "—")</td>
                                    <td>@(teacher.Phone ?? "—")</td>
                                    <td>@(string.IsNullOrWhiteSpace(teacher.Email) ? "—" : teacher.Email)</td>
                                    <td><span class='status-badge @(teacher.FingerprintTemplateCount > 0 ? "active" : "neutral")'>@teacher.FingerprintTemplateCount / 2</span></td>
                                    <td><span class='status-badge @(teacher.IsActive ? "active" : "neutral")'>@(teacher.IsActive ? "Active" : "Inactive")</span></td>
                                    <td>@ScheduleTodayFor(teacher.Id)</td>
                                    <td class="table-actions">
                                        <div class="table-action-group">
                                            <button type="button" class="table-action" title="Manage fingerprints" aria-label="Manage fingerprints for @teacher.DisplayName" @onclick="() => OpenTeacherFingerprints(teacher)"><i class="fas fa-fingerprint"></i></button>
                                            <button type="button" class="table-action" title="Edit" aria-label="Edit teacher" @onclick='() => EditTeacher(teacher.Id)'><i class="fas fa-pen"></i></button>
                                            <button type="button" class='table-action @(teacher.IsActive ? "danger" : string.Empty)' title="@(teacher.IsActive ? "Deactivate" : "Activate")" aria-label="@(teacher.IsActive ? "Deactivate teacher" : "Activate teacher")" @onclick='() => ToggleTeacherActive(teacher)'><i class='fas @(teacher.IsActive ? "fa-toggle-off" : "fa-toggle-on")'></i></button>
                                            <button type="button" class="table-action danger" title="Remove" aria-label="Remove teacher" @onclick='() => OpenDelete("teacher", teacher.Id, teacher.DisplayName)'><i class="fas fa-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    <ListPager State="teacherPager" TotalCount="FilteredTeachers.Count" />
                </article>
                <div class="management-list-actions"><button class="primary-button" @onclick="OpenAddTeacher"><i class="fas fa-plus"></i>Add teacher</button></div>
            }
            else if (active == "semesters")
            {
                <div class="page-intro list-intro">
                    <div class="management-filters">
                            <label class="intro-search"><i class="fas fa-magnifying-glass" aria-hidden="true"></i><input type="search" @bind="semesterSearch" @bind:event="oninput" @bind:after="ResetSemesterPage" placeholder="Search semesters" aria-label="Search semesters" /></label>
                            <select class="intro-filter" @bind="semesterFilter" @bind:after="ResetSemesterPage" aria-label="Filter semesters">
                                <option value="all">All semesters</option>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                    </div>
                </div>
                <article class="panel list-view">
                    <div class="data-table-wrap"><table class="data-table">
                        <thead><tr><th>Name</th><th>Dates</th><th>Status</th><th>Enrolled</th><th>Actions</th></tr></thead>
                        <tbody>
                            @if (FilteredSemesters.Count == 0) { <tr><td colspan="5">@(semesters.Count == 0 ? "No semesters have been created yet." : "No semesters match this search or filter.")</td></tr> }
                            @foreach (var semester in PagedSemesters)
                            {
                                <tr>
                                    <td><strong>@semester.Name</strong></td>
                                    <td>@semester.StartDate.ToString("MMM d, yyyy") – @semester.EndDate.ToString("MMM d, yyyy")</td>
                                    <td><span class='status-badge @(semester.IsActive ? "active" : "neutral")'>@(semester.IsActive ? "Active" : "Inactive")</span></td>
                                    <td>@teacherSemesters.Count(item => item.SemesterId == semester.Id)</td>
                                    <td class="table-actions">
                                        <div class="table-action-group">
                                            <button type="button" class="table-action" title="Enroll teachers" aria-label="Enroll teachers" @onclick='() => SelectSemesterForEnrollment(semester.Id)'><i class="fas fa-user-plus"></i></button>
                                            <button type="button" class='table-action @(semester.IsActive ? "danger" : string.Empty)' title="@(semester.IsActive ? "Deactivate" : "Activate")" aria-label="@(semester.IsActive ? "Deactivate semester" : "Activate semester")" @onclick='() => ToggleSemester(semester)'><i class='fas @(semester.IsActive ? "fa-toggle-off" : "fa-toggle-on")'></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    <ListPager State="semesterPager" TotalCount="FilteredSemesters.Count" />
                </article>
                <div class="management-list-actions"><button class="primary-button" @onclick="OpenAddSemester"><i class="fas fa-plus"></i>Add semester</button></div>
                @if (enrollSemesterId > 0)
                {
                    var selected = semesters.FirstOrDefault(item => item.Id == enrollSemesterId);
                    var enrolled = teacherSemesters.Where(item => item.SemesterId == enrollSemesterId).ToList();
                    var pagedEnrolled = enrollmentPager.Slice(enrolled);
                    <article class="panel enrollment-panel">
                        <div class="panel-heading"><div><span class="eyebrow">ENROLL TEACHERS</span><h3>@(selected?.Name ?? "Semester")</h3></div></div>
                        <div class="form-grid"><label>Teacher<select @bind="enrollTeacherId"><option value="0">Select a teacher</option>@foreach (var teacher in teachers.Where(item => item.IsActive)) { <option value="@teacher.Id">@teacher.DisplayName</option> }</select></label></div>
                        <div class="form-actions"><button class="primary-button" disabled="@(enrollTeacherId == 0)" @onclick="EnrollTeacher">Enroll</button></div>
                        <div class="data-table-wrap"><table class="data-table">
                            <thead><tr><th>Teacher</th><th>Employee #</th><th>Actions</th></tr></thead>
                            <tbody>
                                @if (enrolled.Count == 0) { <tr><td colspan="3">No teachers are enrolled in this semester yet.</td></tr> }
                                @foreach (var enrollment in pagedEnrolled)
                                {
                                    <tr>
                                        <td><span class="table-avatar">@Initials(enrollment.TeacherDisplayName)</span><strong>@enrollment.TeacherDisplayName</strong></td>
                                        <td>@(enrollment.EmployeeNumber ?? "—")</td>
                                        <td class="table-actions"><div class="table-action-group"><button type="button" class="table-action danger" title="Unenroll" aria-label="Unenroll teacher" @onclick='() => UnenrollTeacher(enrollment.TeacherAccountId, enrollment.SemesterId)'><i class="fas fa-user-minus"></i></button></div></td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                        <ListPager State="enrollmentPager" TotalCount="enrolled.Count" />
                    </article>
                }
            }
            else if (active == "classrooms")
            {
                <div class="page-intro list-intro">
                    <div class="management-filters">
                            <label class="intro-search"><i class="fas fa-magnifying-glass" aria-hidden="true"></i><input type="search" @bind="classroomSearch" @bind:event="oninput" @bind:after="ResetClassroomPage" placeholder="Search classrooms" aria-label="Search classrooms" /></label>
                            <select class="intro-filter" @bind="classroomFilter" @bind:after="ResetClassroomPage" aria-label="Filter classrooms">
                                <option value="all">All classrooms</option>
                                <option value="on">AC on</option>
                                <option value="off">AC off</option>
                                <option value="device">With device</option>
                                <option value="no-device">No device</option>
                            </select>
                    </div>
                </div>
                <article class="panel list-view">
                    <div class="data-table-wrap"><table class="data-table">
                        <thead><tr><th>Room</th><th>Capacity</th><th>Device ID</th><th>Target temp</th><th>AC status</th><th>Schedules</th><th>Actions</th></tr></thead>
                        <tbody>
                            @if (FilteredClassrooms.Count == 0) { <tr><td colspan="7">@(classrooms.Count == 0 ? "No classrooms have been created yet." : "No classrooms match this search or filter.")</td></tr> }
                            @foreach (var room in PagedClassrooms)
                            {
                                <tr>
                                    <td><strong>@room.Name</strong></td>
                                    <td>@room.Capacity</td>
                                    <td>@(DeviceIdForRoom(room.Id) ?? "—")</td>
                                    <td>@room.TargetTemperature°C</td>
                                    <td><span class='status-badge @AcStatusBadge(room.AcStatus)'>@AcStatusLabel(room.AcStatus)</span></td>
                                    <td><button type="button" class="text-button" aria-label="View schedules for @room.Name" @onclick='() => ShowClassroomSchedules(room)'><i class="fas fa-calendar-days"></i>View schedules</button></td>
                                    <td class="table-actions"><div class="table-action-group"><button type="button" class="table-action" title="Edit" aria-label="Edit classroom" @onclick='() => EditClassroom(room)'><i class="fas fa-pen"></i></button><button type="button" class="table-action danger" title="Remove" aria-label="Remove classroom" @onclick='() => OpenDelete("classroom", room.Id, room.Name)'><i class="fas fa-trash"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    <ListPager State="classroomPager" TotalCount="FilteredClassrooms.Count" />
                </article>
                <div class="management-list-actions"><button class="primary-button" @onclick="OpenAddClassroom"><i class="fas fa-plus"></i>Add classroom</button></div>
            }
            else if (active == "devices")
            {
                <div class="page-intro list-intro">
                    <label class="enrollment-scanner-select">Enrollment scanner (synchronization not yet available)
                        <select value="@(biometricDevices.FirstOrDefault(device => device.IsEnrollmentScanner)?.Id ?? 0)" @onchange="ChangeEnrollmentScanner" aria-label="Enrollment scanner">
                            <option value="0">Not selected</option>
                            @foreach (var device in biometricDevices)
                            {
                                <option value="@device.Id">@device.DisplayName (@device.DeviceId)</option>
                            }
                        </select>
                    </label>
                    <div class="management-filters">
                        <label class="intro-search"><i class="fas fa-magnifying-glass" aria-hidden="true"></i><input type="search" @bind="deviceSearch" @bind:event="oninput" @bind:after="ResetDevicePage" placeholder="Search devices" aria-label="Search devices" /></label>
                        <select class="intro-filter" @bind="deviceFilter" @bind:after="ResetDevicePage" aria-label="Filter devices">
                            <option value="all">All devices</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                            <option value="assigned">Assigned</option>
                            <option value="unassigned">Unassigned</option>
                            <option value="paired">Paired</option>
                            <option value="unpaired">Not paired</option>
                            <option value="pending">Pairing code pending</option>
                            <option value="scan-enabled">Scan on</option>
                            <option value="scan-disabled">Scan off</option>
                            <option value="enroll-enabled">Enroll on</option>
                            <option value="enroll-disabled">Enroll off</option>
                        </select>
                    </div>
                </div>
                <article class="panel list-view">
                    <div class="data-table-wrap"><table class="data-table">
                        <thead><tr><th>Device</th><th>Device ID</th><th>Pairing</th><th>Assigned room</th>
                                                    <th>AC target</th><th>Status poll</th><th>Device features</th><th>Status</th><th>Actions</th></tr></thead>
                                                <tbody>
                                                    @if (FilteredDevices.Count == 0) { <tr><td colspan="9">@(biometricDevices.Count == 0 ? "No devices have been registered yet." : "No devices match this search or filter.")</td></tr> }
                                                    @foreach (var device in PagedDevices)
                                                    {
                                                        <tr>
                                                            <td><strong>@device.DisplayName</strong></td>
                                                            <td><code>@device.DeviceId</code></td>
                                                            <td>
                                                                @if (device.PairingCode is not null) { <span class="status-badge neutral">Code <code>@device.PairingCode</code></span> }
                                                                else if (device.IsPaired) { <span class="status-badge active">Paired</span> }
                                                                else { <span class="status-badge neutral">Not paired</span> }
                                                                <button type="button" class="text-button" aria-label="Generate pairing code for @device.DisplayName" @onclick='() => NewPairingCode(device)'><i class="fas fa-link"></i>@(device.PairingCode is null ? "New code" : "Regenerate")</button>
                                                            </td>
                                    <td>@(device.ClassroomName ?? "Unassigned")</td>
                                    <td>@(device.TargetTemperature is int targetTemperature ? $"{targetTemperature}°C" : "—")</td>
                                    <td>@device.StatusPollingIntervalSeconds sec</td>
                                    <td>
                                        <span class='status-badge @(device.AttendanceScanEnabled ? "active" : "neutral")'>Scan @(device.AttendanceScanEnabled ? "on" : "off")</span>
                                        <span class='status-badge @(device.FingerprintEnrollmentEnabled ? "active" : "neutral")'>Enroll @(device.FingerprintEnrollmentEnabled ? "on" : "off")</span>
                                    </td>
                                    <td><span class='status-badge @(device.IsActive ? "active" : "neutral")'>@(device.IsActive ? "Active" : "Inactive")</span></td>
                                    <td class="table-actions"><button type="button" class="table-action" title="Edit device settings" aria-label="Edit @device.DisplayName settings" @onclick='() => EditDevice(device)'><i class="fas fa-pen"></i></button><button type="button" class="table-action" title="Delete device" aria-label="Delete @device.DisplayName" @onclick='() => OpenDelete("device", device.Id, device.DisplayName)'><i class="fas fa-trash"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    <ListPager State="devicePager" TotalCount="FilteredDevices.Count" />
                </article>
                <div class="management-list-actions"><button class="primary-button" @onclick="OpenAddDevice"><i class="fas fa-plus"></i>Register device</button></div>
            }
            else if (active == "schedules")
            {
                <div class="page-intro list-intro">
                    <div class="management-filters">
                            <label class="intro-search"><i class="fas fa-magnifying-glass" aria-hidden="true"></i><input type="search" @bind="scheduleSearch" @bind:event="oninput" @bind:after="ResetSchedulePage" placeholder="Search schedules" aria-label="Search schedules" /></label>
                            <select class="intro-filter" @bind="scheduleFilter" @bind:after="OnScheduleFilterChanged" aria-label="Filter schedules">
                                <option value="all">All schedules</option>
                                <option value="today">Today</option>
                                <option value="date">On date…</option>
                                <option value="upcoming">Upcoming</option>
                                <option value="past">Past</option>
                                <option value="regular">Regular</option>
                                <option value="makeup">Makeup</option>
                            </select>
                            @if (scheduleFilter == "date")
                            {
                                <label class="intro-date"><span class="visually-hidden">Schedule date</span><input type="date" @bind="scheduleFilterDate" @bind:after="ResetSchedulePage" aria-label="Choose schedule date" /></label>
                            }
                    </div>
                    @if (scheduleClassroomFilterId is not null)
                    {
                        <div>
                            <span>Schedules for <strong>@scheduleClassroomFilterName</strong></span>
                        </div>
                    }
                </div>
                <article class="panel list-view">
                    <div class="data-table-wrap"><table class="data-table">
                        <thead><tr><th>Teacher</th><th>Semester</th><th>Kind</th><th>Classroom</th><th>Subject</th><th>Date</th><th>Time</th><th>Actions</th></tr></thead>
                        <tbody>
                            @if (FilteredSchedules.Count == 0) { <tr><td colspan="8">@(scheduleClassroomFilterId is long roomId && !schedules.Any(item => item.ClassroomId == roomId) ? "No schedules are assigned to this classroom." : schedules.Count == 0 ? "No schedules have been stored yet." : "No schedules match this search or filter.")</td></tr> }
                            @foreach (var schedule in PagedSchedules)
                            {
                                <tr>
                                    <td><strong>@schedule.TeacherDisplayName</strong></td>
                                    <td>@(schedule.SemesterName ?? "—")</td>
                                    <td><span class='status-badge @(schedule.ScheduleKind == "Makeup" ? "pending" : "neutral")'>@schedule.ScheduleKind</span></td>
                                    <td>@schedule.ClassroomName</td>
                                    <td>@schedule.SubjectName</td>
                                    <td>@schedule.ScheduleDate.ToString("MMM d, yyyy")</td>
                                    <td>@schedule.StartTime.ToString("HH:mm") – @schedule.EndTime.ToString("HH:mm")</td>
                                    <td class="table-actions"><div class="table-action-group"><button type="button" class="table-action" title="Move" aria-label="Move schedule" @onclick='() => OpenMoveSchedule(schedule)'><i class="fas fa-calendar-day"></i></button><button type="button" class="table-action danger" title="Delete" aria-label="Delete schedule" @onclick='() => OpenDelete("schedule", schedule.Id, $"{schedule.SubjectName} · {schedule.ClassroomName} · {schedule.ScheduleDate:MMM d, yyyy} {schedule.StartTime:HH\\:mm}")'><i class="fas fa-trash"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    <ListPager State="schedulePager" TotalCount="FilteredSchedules.Count" />
                </article>
                <div class="management-list-actions">
                    @if (scheduleClassroomFilterId is not null)
                    {
                        <button type="button" class="primary-button" @onclick="ClearScheduleClassroomFilter">Show all schedules</button>
                        <button type="button" class="primary-button" @onclick='() => Navigate("classrooms")'>Back to classrooms</button>
                    }
                    <button class="primary-button" @onclick="OpenAddSchedule"><i class="fas fa-plus"></i>Add schedule</button>
                </div>
            }
            else if (active == "temperature")
            {
                <div class="page-intro"><span>Temperature targets are saved in the portal. IR transmission does not verify AC reception or the physical setpoint. Restart the scanner and reconcile after an uncertain command.</span></div>
                <article class="panel">
                    <div class="panel-heading"><div><span class="eyebrow">ROOM STATUS</span><h3>All classrooms</h3></div></div>
                    <div class="data-table-wrap"><table class="data-table">
                        <thead><tr><th>Classroom</th><th>Device</th><th>Target</th><th>IR synchronization</th><th>AC status</th><th>Actions</th></tr></thead>
                        <tbody>
                            @if (classrooms.Count == 0) { <tr><td colspan="6">Add a classroom before sending AC commands.</td></tr> }
                            @foreach (var room in PagedAcRooms)
                            {
                                var acOn = AcIsOn(room.AcStatus);
                                var ir = irSnapshots.FirstOrDefault(item => item.ClassroomId == room.Id);
                                <tr>
                                    <td><strong>@room.Name</strong></td>
                                    <td>@(DeviceIdForRoom(room.Id) ?? "—")</td>
                                    <td>@room.TargetTemperature°C</td>
                                    <td>
                                        @if (irStatusUnavailable) { <span>IR status unavailable; target unverified</span> }
                                        else if (!Configuration.GetValue<bool>("AcIr:EnableDeviceApi")) { <span>IR disabled; AC unverified</span> }
                                        else if (ir is null) { <span>Unavailable; target not verified</span> }
                                        else if (Configuration.GetValue<bool>("AcIr:EnablePowerToggle") != (ir.ProtocolVersion == 2)) { <span>Restart scanner with matching IR protocol; then reconcile.</span> }
                                        else if (ir.State == "reconcile") { <span>Target pending; reconciliation required</span><button type="button" class="text-button" @onclick="() => BeginIrReconciliation(ir)">Reconcile</button> }
                                        else if (ir.State == "inflight") { <span>Target pending; command uncertain/in progress. Restart and reconcile if stalled.</span> }
                                        else if (!ir.RecentlySeen) { <span>Scanner not recently seen; target pending or unverified</span> }
                                        else if (ir.Assumed != ir.Target) { <span>Pending; assumed @ir.Assumed°C</span> }
                                        else { <span>Assumed @ir.Assumed°C; not verified</span> }
                                        @if (ir?.ProtocolVersion == 2) { <span> Attendance power requested @(ir.DesiredPower ? "ON" : "OFF"); assumed @(ir.AssumedPower is null ? "unknown" : ir.AssumedPower.Value ? "ON" : "OFF")@(ir.AssumedPower != ir.DesiredPower ? " (pending)" : ""); not verified.</span> }
                                    </td>
                                    <td><span class='status-badge @AcStatusBadge(room.AcStatus)'>@AcStatusLabel(room.AcStatus)</span></td>
                                    <td class="table-actions">
                                        <div class="table-action-group">
                                            <button type="button" class='table-action @(acOn ? "danger" : string.Empty)' title="@(acOn ? "Turn AC off" : "Turn AC on")" aria-label="@(acOn ? $"Turn off AC for {room.Name}" : $"Turn on AC for {room.Name}")" @onclick='() => RemoteAc(room.Id, !acOn)'><i class='fas @(acOn ? "fa-toggle-off" : "fa-toggle-on")'></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    <ListPager State="acRoomPager" TotalCount="classrooms.Count" />
                </article>
                <article class="panel"><div class="panel-heading"><div><span class="eyebrow">COMMAND LOG</span><h3>Recent temperature events</h3></div></div><div class="data-table-wrap"><table class="data-table"><thead><tr><th>Classroom</th><th>Event</th><th>Target</th><th>Recorded</th></tr></thead><tbody>@if (temperatureLogs.Count == 0) { <tr><td colspan="4">No temperature commands have been logged.</td></tr> } @foreach (var log in PagedTemperatureLogs) { <tr><td>@log.ClassroomName</td><td>@log.EventType</td><td>@(log.TargetTemperature is null ? "—" : $"{log.TargetTemperature}°C")</td><td>@SchoolClock.Format(log.RecordedAt, "MMM d HH:mm")</td></tr> }</tbody></table></div><ListPager State="temperatureLogPager" TotalCount="temperatureLogs.Count" /></article>
            }
            else if (active == "attendance")
            {
                <div class="page-intro"><span>Outcomes are derived from punches vs the schedule window: On time, Late, Absent, or Missing time-out.</span></div>
                <article class="panel">
                    <div class="panel-heading"><div><span class="eyebrow">REPORTS</span><h3>Create attendance report</h3></div></div>
                    <p class="form-help">Reports include all matching records. Dates use the scheduled class date when available. Active sessions are counted separately, including active late sessions.</p>
                    <form method="get" target="_blank" action="/reports/attendance/print">
                        <div class="form-grid">
                            <label>From<input type="date" name="from" value="@Today.AddDays(1 - Today.Day).ToString("yyyy-MM-dd")" required /></label>
                            <label>To<input type="date" name="to" value="@Today.ToString("yyyy-MM-dd")" required /></label>
                            <label>Teacher<select name="teacher"><option value="">All teachers</option>@foreach (var teacher in teachers.OrderBy(item => item.DisplayName)) { <option value="@teacher.Id">@teacher.DisplayName</option> }</select></label>
                            <label>Classroom<select name="classroom"><option value="">All classrooms</option>@foreach (var room in classrooms.Select(item => (item.Id, item.Name)).Concat(attendance.Select(item => (item.ClassroomId, item.ClassroomName))).GroupBy(item => item.Item1).Select(group => group.First()).OrderBy(item => item.Item2)) { <option value="@room.Item1">@room.Item2</option> }</select></label>
                            <label>Outcome<select name="outcome"><option value="">All outcomes</option>@foreach (var outcome in AttendanceReport.Outcomes) { <option value="@outcome">@AttendanceReport.Label(outcome)</option> }</select></label>
                        </div>
                        <p class="form-help">Use Print / PDF to print or save as PDF in your browser. The Excel download is an .xlsx workbook.</p>
                        <div class="form-actions report-actions">
                            <button type="submit" class="secondary-button" formaction="/reports/attendance/xlsx"><i class="fas fa-file-excel" aria-hidden="true"></i>Download Excel</button>
                            <button type="submit" class="primary-button"><i class="fas fa-print" aria-hidden="true"></i>Print / PDF</button>
                        </div>
                    </form>
                </article>
                <article class="panel"><div class="data-table-wrap"><table class="data-table"><thead><tr><th>Teacher</th><th>Classroom</th><th>Time in</th><th>Time out</th><th>Verification</th><th>Outcome</th></tr></thead><tbody>@if (attendance.Count == 0) { <tr><td colspan="6">No attendance logs have been recorded.</td></tr> } @foreach (var item in PagedAttendance) { <tr><td><strong>@item.TeacherDisplayName</strong></td><td>@item.ClassroomName</td><td>@(item.Outcome == AttendanceOutcomes.Absent ? "—" : SchoolClock.Format(item.TimeIn, "MMM d HH:mm"))</td><td>@(item.Outcome == AttendanceOutcomes.Absent ? "—" : SchoolClock.Format(item.TimeOut, "MMM d HH:mm"))</td><td>@item.VerificationMethod</td><td><span class='status-badge @AttendanceOutcomes.BadgeClass(item.Outcome, item.Status)'>@AttendanceOutcomes.Display(item.Outcome, item.Status)</span></td></tr> }</tbody></table></div><ListPager State="attendancePager" TotalCount="attendance.Count" /></article>
            }
            else if (active == "buzzer")
            {
                <div class="page-intro"><span>Set schedule-ending reminders for all scanners.</span></div>
                <div class="settings-grid">
                    <article class="panel settings-panel">
                        <div class="settings-panel-body">
                            <span class="eyebrow">SCHEDULE REMINDERS</span>
                            <h3>Buzzer settings</h3>
                            <p class="form-help">A five-second melody is played on supported scanners while a teacher has an active attendance session in the assigned room. Reminders require a connected scanner and stop when the schedule ends.</p>
                            <div class="form-stack">
                                <label><span><input type="checkbox" @bind="buzzerEnabled" disabled="@(!buzzerLoaded)" /> Enable reminders</span></label>
                                <label>First reminder before end (minutes)<input type="number" min="1" max="180" @bind="buzzerLeadMinutes" disabled="@(!buzzerLoaded)" /></label>
                                <label>Repeat every (minutes)<input type="number" min="1" max="180" @bind="buzzerRepeatMinutes" disabled="@(!buzzerLoaded)" /></label>
                            </div>
                            <p class="form-help">Changes take effect on connected scanners on their next reminder check. Missed reminders are not replayed after an outage.</p>
                        </div>
                        <div class="dialog-actions"><button type="button" class="primary-button" @onclick="SaveBuzzerSettings" disabled="@(!buzzerLoaded || buzzerSaving)">Save settings</button></div>
                    </article>
                    <article class="panel settings-panel">
                        <div class="settings-panel-body">
                            <span class="eyebrow">DEVICE TEST</span>
                            <h3>Test buzzer</h3>
                            <p class="form-help">Play a five-second melody on one active, paired device with firmware 1.6.56 or newer, even when scheduled reminders are disabled. The request expires after 30 seconds; hearing the sound is the only confirmation. Older firmware uses three short tones.</p>
                            <div class="form-stack">
                                <label>Device<select @bind="buzzerTestDeviceId" disabled="@buzzerTestSending">
                                    <option value="0">Select a device</option>
                                    @foreach (var device in biometricDevices.Where(item => item.IsActive && item.IsPaired).OrderBy(item => item.DisplayName))
                                    {
                                        <option value="@device.Id">@device.DisplayName — @(device.ClassroomName ?? "Unassigned")</option>
                                    }
                                </select></label>
                            </div>
                            <AutoDismiss Active="@(!string.IsNullOrEmpty(buzzerTestStatus) && !buzzerTestSending)" Version="@buzzerTestStatusVersion" Dismissed="DismissBuzzerTestStatus">
                                <p class="form-help" role="status">@buzzerTestStatus</p>
                            </AutoDismiss>
                        </div>
                        <div class="dialog-actions"><button type="button" class="primary-button" @onclick="SendBuzzerTest" disabled="@(buzzerTestSending || buzzerTestDeviceId == 0)">Test buzzer</button></div>
                    </article>
                </div>
            }
            else if (active == "gsm")
            {
                <div class="page-intro"><span>Configure the USB modem connected to the portal computer.</span></div>
                <div class="settings-grid">
                    <article class="panel settings-panel">
                        <div class="settings-panel-body">
                            <span class="eyebrow">SIM800L MODEM</span>
                            <h3>Serial connection</h3>
                            <p class="form-help">Port discovery does not identify which device is the modem. Verify the port before selecting it.</p>
                            <p class="form-help">Saving settings does not open the port or send messages. Faculty OTP requires additional configuration.</p>
                            <div class="form-stack">
                                <label>COM port
                                    <select @bind="gsmPort">
                                        <option value="">Select a port</option>
                                        @if (!string.IsNullOrEmpty(gsmPort) && !gsmPorts.Contains(gsmPort))
                                        {
                                            <option value="@gsmPort">@gsmPort (not currently available)</option>
                                        }
                                        @foreach (var port in gsmPorts) { <option value="@port">@port</option> }
                                    </select>
                                </label>
                                <label>Baud rate
                                    <select @bind="gsmBaudRate">
                                        @foreach (var baud in GsmModemSettingsStore.BaudRates) { <option value="@baud">@baud</option> }
                                    </select>
                                </label>
                            </div>
                        </div>
                        <div class="dialog-actions">
                            <button type="button" class="secondary-button" @onclick="RefreshGsmPorts">Refresh ports</button>
                            <button type="button" class="primary-button" @onclick="SaveGsmSettings">Save settings</button>
                        </div>
                    </article>
                    <article class="panel settings-panel">
                        <div class="settings-panel-body">
                            <span class="eyebrow">MODEM TEST</span>
                            <h3>Send test SMS</h3>
                            <p class="form-help">Uses the saved connection and sends a fixed test message. Standard SMS charges may apply.</p>
                            <div class="form-stack">
                                <label>Recipient mobile number
                                    <input type="tel" inputmode="numeric" autocomplete="off" maxlength="11" placeholder="09xxxxxxxxx" @bind="gsmTestPhone" disabled="@(gsmTestPreparing || gsmTestSending)" />
                                </label>
                            </div>
                            @if (gsmTestSending) { <p class="form-help" role="status">@gsmTestStatus</p> }
                            else
                            {
                                <AutoDismiss Active="@(!string.IsNullOrEmpty(gsmTestStatus))" Version="@gsmTestStatusVersion" Dismissed="DismissGsmTestStatus">
                                    <p class="form-help" role="status">@gsmTestStatus</p>
                                </AutoDismiss>
                            }
                        </div>
                        <div class="dialog-actions">
                            <button type="button" class="primary-button" @onclick="PrepareGsmTest" disabled="@(gsmTestPreparing || gsmTestSending)">@(gsmTestSending ? "Sending…" : gsmTestPreparing ? "Checking…" : "Test SMS")</button>
                        </div>
                    </article>
                </div>
            }
            else
            {
                <div class="settings-grid">
                    <article class="panel settings-panel">
                        <div class="settings-panel-body">
                            <span class="eyebrow">ADMIN CREDENTIALS</span>
                            <h3>Account contact</h3>
                            <div class="form-stack">
                                <label>Current password<input type="password" @bind="adminCurrentPassword" autocomplete="current-password" /></label>
                                <label>Registered admin email<input type="email" @bind="adminEmail" /></label>
                                <label>New password<input type="password" @bind="adminNewPassword" placeholder="Leave blank to keep current password" autocomplete="new-password" /></label>
                            </div>
                        </div>
                        <button class="primary-button" @onclick="SaveAdminSettings">Save settings</button>
                    </article>
                    <article class="panel settings-panel">
                        <div class="settings-panel-body">
                            <span class="eyebrow">FINGERPRINT DEVICES</span>
                            <h3>Clear sensor fingerprints</h3>
                            <p class="form-help"><strong>@fingerprintTemplateCount</strong> template(s) currently stored · <strong>@biometricDevices.Count(device => device.IsActive)</strong> active scanner(s)</p>
                        </div>
                        <button class="danger-outline-button" @onclick='() => clearFingerprintsOpen = true'>Clear fingerprint device data</button>
                    </article>
                    <article class="panel settings-panel">
                        <div class="settings-panel-body">
                            <span class="eyebrow">DEVICE ADMIN PIN</span>
                            <h3>Unlock admin options on the scanner</h3>
                            <p class="form-help">@(hasAdminDevicePin ? "Admin PIN set" : "Admin PIN not set") · Different from the pairing code</p>
                            <input type="password" inputmode="numeric" maxlength="6" autocomplete="off" @bind="adminDevicePin" @bind:event="oninput" placeholder="6-digit admin PIN" aria-label="Device admin PIN" />
                        </div>
                        <button class="primary-button" @onclick="SaveAdminDevicePin">Save device PIN</button>
                    </article>
                    <article class="panel settings-panel">
                        <div class="settings-panel-body">
                            <span class="eyebrow">FINGERPRINT SAFETY</span>
                            <h3>Block a sensor slot</h3>
                            <p class="form-help">Blocked slots cannot identify a teacher on any scanner. This does not erase the sensor or change its mapping. Blocks remain after a fingerprint clear.</p>
                            <label>Slot number<input type="number" min="1" max="65535" placeholder="Enter slot number" @bind="fingerprintSlotToBlock" /></label>
                            @if (blockedSlotsLoaded)
                            {
                                <p class="form-help">Blocked slots: @(blockedFingerprintSlots.Count == 0 ? "None" : string.Join(", ", blockedFingerprintSlots))</p>
                            }
                            @if (inspectedFingerprintSlot is not null)
                            {
                                <p class="form-help">Server slot @inspectedFingerprintSlot.Slot: @(inspectedFingerprintSlot.IsBlocked ? "Blocked" : "Not blocked") · @(inspectedFingerprintSlot.TeacherName is null ? "No mapping" : $"{inspectedFingerprintSlot.TeacherName} ({(inspectedFingerprintSlot.TeacherIsActive == true ? "active" : "inactive")})")</p>
                                <p class="form-help">This checks the server only, not the physical scanner.</p>
                            }
                        </div>
                        <div class="dialog-actions">
                            <button type="button" class="secondary-button" @onclick="LoadBlockedFingerprintSlots">Show blocked slots</button>
                            <button type="button" class="secondary-button" @onclick="InspectFingerprintSlot">Inspect slot</button>
                            <button type="button" class="danger-outline-button" @onclick="BlockFingerprintSlot">Block slot</button>
                        </div>
                    </article>
                    <article class="panel settings-panel">
                        <div class="settings-panel-body">
                            <span class="eyebrow">FRESH START</span>
                            <h3>Reset system to first access</h3>
                            <p class="form-help">This permanently clears teachers, classrooms, schedules, attendance, and temperature logs; then it creates the configured default administrator with no email.</p>
                        </div>
                        <button class="danger-button" @onclick='() => resetOpen = true'>Reset all system data</button>
                    </article>
                </div>
            }
        </section>
    </main>
</div>

@if (gsmTestConfirmation is not null)
{
    <div class="modal-backdrop">
        <section class="dialog-card" role="dialog" aria-modal="true" aria-labelledby="gsm-test-title">
            <h2 id="gsm-test-title">Send a test SMS?</h2>
            <p>Send “SmartClassAC modem test message.” to <strong>@gsmTestRecipient</strong> using <strong>@gsmTestConfirmation.PortName</strong> at <strong>@gsmTestConfirmation.BaudRate baud</strong>?</p>
            <p class="form-help">Standard SMS charges may apply. Confirm that this is the USB modem port.</p>
            <div class="dialog-actions">
                <button type="button" class="secondary-button" @onclick="CancelGsmTest">Cancel</button>
                <button type="button" class="primary-button" @onclick="SendGsmTest">Send SMS</button>
            </div>
        </section>
    </div>
}

@if (teacherModalOpen)
{
    <div class="modal-backdrop" @onclick="DismissTeacherForm">
        <section class="dialog-card form-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            @if (teacherOtpStep)
            {
                <span class="eyebrow">VERIFY MOBILE</span>
                <h2>Verify mobile number</h2>
                <p class="form-help">A verification code was submitted to <strong>@newTeacherPhone</strong>. It expires after five minutes.</p>
                <div class="form-grid">
                    <label>SMS verification code<input @bind="teacherRegistrationOtp" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" placeholder="6-digit code" autocomplete="one-time-code" /></label>
                </div>
                <div class="dialog-actions">
                    <button class="secondary-button" disabled="@teacherOtpBusy" @onclick="BackFromTeacherOtp">Back</button>
                    <button class="primary-button" disabled="@teacherOtpBusy" @onclick="SaveTeacher">Verify &amp; save teacher</button>
                </div>
            }
            else
            {
                <span class="eyebrow">@(editingTeacherId == 0 ? "ADD TEACHER" : "EDIT TEACHER")</span>
                <h2>@(editingTeacherId == 0 ? "New teacher account" : "Update teacher account")</h2>
                <div class="form-grid">
                    <label>Teacher name<input @bind="newTeacherName" autocomplete="name" /></label>
                    <label>Employee number<input @bind="newTeacherEmployeeNumber" placeholder="e.g. EMP-1042" /></label>
                    <label>Username<input @bind="newTeacherUsername" autocomplete="username" /></label>
                    <label>Mobile number<input @bind="newTeacherPhone" maxlength="11" inputmode="numeric" pattern="09[0-9]{9}" placeholder="09xxxxxxxxx" autocomplete="tel" /><small class="form-help">Required. Format: 09xxxxxxxxx</small></label>
                    <label>School email<input @bind="newTeacherEmail" type="email" autocomplete="email" /><small class="form-help">Optional</small></label>
                    <label>Device PIN<input @bind="newTeacherDevicePin" maxlength="6" placeholder="4–6 digits" inputmode="numeric" pattern="[0-9]*" /><small class="form-help">@(editingTeacherId == 0 ? "Optional; auto-assigned if blank." : "Leave blank to keep the current PIN.")</small></label>
                    <label>@(editingTeacherId == 0 ? "Login password" : "New password")<input @bind="newTeacherPassword" type="password" placeholder="@(editingTeacherId == 0 ? string.Empty : "Leave blank to keep current password")" autocomplete="new-password" /><small class="form-help">@(editingTeacherId == 0 ? "Use at least 10 characters with an uppercase letter, lowercase letter, and number; no spaces." : "Leave blank to keep the current password. If changing it, use at least 10 characters with an uppercase letter, lowercase letter, and number; no spaces.")</small></label>
                </div>
                <div class="dialog-actions">
                    <button class="secondary-button" disabled="@teacherOtpBusy" @onclick="ClearTeacherForm">Cancel</button>
                    <button class="primary-button" disabled="@teacherOtpBusy" @onclick="SaveTeacher">@(editingTeacherId == 0 ? "Continue" : "Update teacher")</button>
                </div>
            }
            @if (!string.IsNullOrEmpty(teacherFormError))
            {
                <p class="alert alert-danger" role="alert">@teacherFormError</p>
            }
        </section>
    </div>
}

@if (semesterModalOpen)
{
    <div class="modal-backdrop" @onclick="CloseSemesterModal">
        <section class="dialog-card form-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <span class="eyebrow">NEW SEMESTER</span>
            <h2>Create semester</h2>
            <div class="form-grid">
                <label>Name<input @bind="semesterName" maxlength="120" placeholder="AY 2025-2026 Sem 1" /></label>
                <label>Start date<input type="date" @bind="semesterStartDate" /></label>
                <label>End date<input type="date" @bind="semesterEndDate" /></label>
            </div>
            <div class="dialog-actions">
                <button class="secondary-button" @onclick="CloseSemesterModal">Cancel</button>
                <button class="primary-button" @onclick="SaveSemester">Create semester</button>
            </div>
        </section>
    </div>
}

@if (classroomModalOpen)
{
    <div class="modal-backdrop" @onclick="ClearClassroomForm">
        <section class="dialog-card form-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <span class="eyebrow">@(editingClassroomId == 0 ? "ADD CLASSROOM" : "EDIT CLASSROOM")</span>
            <h2>@(editingClassroomId == 0 ? "New classroom" : "Update classroom")</h2>
            <div class="form-grid">
                <label>Room name<input @bind="classroomName" maxlength="100" placeholder="Room 301" /></label>
                <label>Capacity<input type="number" @bind="classroomCapacity" min="1" max="1000" /></label>
                <label>Target temperature<input type="number" @bind="classroomTargetTemperature" min="16" max="30" /><small class="form-help">Saved target; AC reception and physical setpoint are not verified.</small></label>
                <label>Teacher minimum temperature<input type="number" @bind="classroomMinimumTemperature" min="16" max="30" /><small class="form-help">Teachers cannot select a lower target.</small></label>
            </div>
            <div class="dialog-actions">
                <button class="secondary-button" @onclick="ClearClassroomForm">Cancel</button>
                <button class="primary-button" @onclick="SaveClassroom">@(editingClassroomId == 0 ? "Add classroom" : "Save classroom")</button>
            </div>
        </section>
    </div>
}

@if (deviceModalOpen)
{
    <div class="modal-backdrop" @onclick="CloseDeviceModal">
        <section class="dialog-card form-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <span class="eyebrow">DEVICE MANAGEMENT</span>
            <h2>@(editingDeviceId == 0 ? "Register device" : "Device settings")</h2>
            <div class="form-grid">
                @if (editingDeviceId == 0)
                {
                    <p class="form-help">A numeric Device ID and a one-time 6-digit pairing code are generated when you register this device. On the device, open the admin menu, enter the admin PIN, choose Pair device, and enter the code. The device then stores its Device ID.</p>
                }
                else
                {
                    <label>Device ID<input value="@deviceId" readonly /></label>
                }
                <label>Device name<input value="@(editingDeviceId == 0 ? "Assigned automatically" : deviceDisplayName)" readonly /></label>
                <label>Assigned classroom
                    <select @bind="deviceClassroomId" @bind:after="OnDeviceClassroomChanged">
                        <option value="">Unassigned</option>
                        @foreach (var room in AvailableDeviceClassrooms(editingDeviceId == 0 ? null : editingDeviceId))
                        {
                            <option value="@room.Id">@room.Name</option>
                        }
                    </select>
                </label>
                @if (deviceClassroomId is not null)
                {
                    <label>AC target temperature<input type="number" @bind="deviceTargetTemperature" min="16" max="30" /> <small class="form-help">Saved room target; AC reception and physical setpoint are not verified.</small></label>
                }
                <label>Status polling interval (seconds)<input type="number" @bind="devicePollingIntervalSeconds" min="@BiometricDeviceSettingsPolicy.MinStatusPollingIntervalSeconds" max="@BiometricDeviceSettingsPolicy.MaxStatusPollingIntervalSeconds" /></label>
            </div>
            <div class="device-options" role="group" aria-label="Device options">
                <label class="weekday-chip"><input type="checkbox" @bind="deviceAttendanceScanEnabled" /><span>Attendance scans</span></label>
