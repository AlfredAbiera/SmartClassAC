    {
        var profile = await AuthService.GetTeacherProfileForAdminAsync(accountId);
        if (profile is null) { Toast("Teacher profile could not be loaded."); return; }
        editingTeacherId = profile.AccountId;
        newTeacherName = profile.DisplayName;
        newTeacherUsername = profile.Username;
        newTeacherEmployeeNumber = profile.EmployeeNumber ?? string.Empty;
        newTeacherEmail = profile.Email ?? string.Empty;
        newTeacherPhone = profile.Phone ?? string.Empty;
        newTeacherDevicePin = profile.DevicePin ?? string.Empty;
        newTeacherPassword = string.Empty;
        teacherOtpStep = false;
        teacherRegistrationOtp = string.Empty;
        active = "teachers";
        teacherModalOpen = true;
    }

