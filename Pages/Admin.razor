    {
        if (scheduleRecurrence != ScheduleRecurrence.Custom)
        {
            scheduleCustomDays.Clear();
        }

        StateHasChanged();
    }

    private void ToggleScheduleWeekday(DayOfWeek day, bool selected)
    {
        if (selected)
        {
