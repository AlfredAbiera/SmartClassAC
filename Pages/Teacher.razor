@page "/teacher"
@using Microsoft.Extensions.Options
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject CustomAuthStateProvider AuthStateProvider
@inject IOptions<SchoolTimeOptions> SchoolTime
@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Teacher Dashboard | SmartClass AC</PageTitle>

<div class="dashboard-page teacher-dashboard">
    <aside class='dashboard-sidebar @(sidebarOpen ? "is-open" : string.Empty)'>
        <a class="dashboard-brand" href="/"><span class="brand-mark"><i class="fas fa-snowflake"></i></span><span>SmartClass <strong>AC</strong></span></a>
        <p class="workspace-label">TEACHER WORKSPACE</p>
        <nav class="dashboard-nav" aria-label="Teacher dashboard">
            <button class='@NavClass("overview")' @onclick='() => Navigate("overview")'><i class="fas fa-gauge-high"></i>Overview</button>
            <p class="nav-group-label">MY WORKSPACE</p>
            <button class='@NavClass("profile")' @onclick='() => Navigate("profile")'><i class="fas fa-user"></i>My profile</button>
            <button class='@NavClass("schedule")' @onclick='() => Navigate("schedule")'><i class="fas fa-calendar-days"></i>My schedule</button>
            <button class='@NavClass("attendance")' @onclick='() => Navigate("attendance")'><i class="fas fa-clipboard-check"></i>Attendance history</button>
            <p class="nav-group-label">CLASSROOM</p>
            <button class='@NavClass("classroom")' @onclick='() => Navigate("classroom")'><i class="fas fa-temperature-half"></i>Classroom temperature</button>
            <button class='@NavClass("active")' @onclick='() => Navigate("active")'><i class="fas fa-chalkboard-user"></i>Active class</button>
        </nav>
        <button class="sidebar-logout" @onclick="Logout"><i class="fas fa-arrow-right-from-bracket"></i>Log out</button>
    </aside>
    @if (sidebarOpen) { <button class="sidebar-scrim" aria-label="Close navigation" @onclick="ToggleSidebar"></button> }

    <main class="dashboard-main">
        <header class="dashboard-topbar">
            <button class="icon-button mobile-nav-toggle" aria-label="Open navigation" @onclick="ToggleSidebar"><i class="fas fa-bars"></i></button>
            <div class="topbar-title"><span class="eyebrow">SMARTCLASS AC / TEACHER</span><h1>@Title</h1></div>
            <div class="topbar-actions"><button class="profile-chip" @onclick='() => Navigate("profile")'><span>@Initials</span><strong>@TeacherName</strong><i class="fas fa-chevron-down"></i></button></div>
        </header>
        <section class="dashboard-content">
            @if (!string.IsNullOrEmpty(message)) { <div class="dashboard-toast" role="status"><i class="fas fa-circle-check"></i>@message<button @onclick='() => message = string.Empty' aria-label="Dismiss"><i class="fas fa-xmark"></i></button></div> }

            @if (isLoading)
            {
                <article class="panel"><p class="form-help">Loading your records…</p></article>
            }
            else if (profile is null)
            {
                <article class="panel"><h2>Teacher account unavailable</h2><p class="form-help">Your active teacher account could not be loaded.</p></article>
            }
            else if (active == "overview")
            {
                <div class="teacher-welcome"><div><p>@SchoolClock.GetNow(SchoolTime.Value).ToString("dddd, MMMM d")</p><h2>Welcome back, @TeacherName.</h2><span>Your dashboard is showing only your account and assignments.</span></div><div class="teacher-avatar-large">@Initials<span class="online-indicator"></span></div></div>
                <div class="metric-grid teacher-metric-grid">
                    <article class="metric-card blue"><span class="metric-icon"><i class="fas fa-chalkboard-user"></i></span><div><small>ACTIVE CLASS</small><strong>@(ActiveAttendance is null ? "None" : ActiveAttendance.ClassroomName)</strong><p>@(ActiveAttendance is null ? "No class is currently active" : "Time-in recorded")</p></div></article>
                    <article class="metric-card teal"><span class="metric-icon"><i class="fas fa-temperature-half"></i></span><div><small>ASSIGNED ROOMS</small><strong>@TodaySchedules.Select(schedule => schedule.ClassroomId).Distinct().Count()</strong><p>Today’s scheduled classrooms</p></div></article>
                    <article class="metric-card violet"><span class="metric-icon"><i class="fas fa-fingerprint"></i></span><div><small>ATTENDANCE TODAY</small><strong>@(TodayAttendance.Count == 0 ? "Not recorded" : AttendanceOutcomes.Display(TodayAttendance[0].Outcome, TodayAttendance[0].Status))</strong><p>Biometric workflow log</p></div></article>
                </div>
                <div class="dashboard-grid teacher-overview-grid">
                    <article class="panel class-now-panel"><div class="panel-heading"><div><span class="eyebrow">TODAY'S ASSIGNMENTS</span><h3>@(TodaySchedules.FirstOrDefault()?.SubjectName ?? "No schedule today")</h3></div><span class='status-badge @(ActiveAttendance is null ? "neutral" : "active")'>@(ActiveAttendance is null ? "Scheduled" : "In session")</span></div>
                        @if (TodaySchedules.Count == 0) { <p class="form-help">Ask an administrator to create a classroom and schedule before starting a class.</p> }
                        else { <div class="class-now-details"><div><i class="fas fa-door-open"></i><span><small>Classroom</small><strong>@TodaySchedules[0].ClassroomName</strong></span></div><div><i class="fas fa-clock"></i><span><small>Schedule</small><strong>@TodaySchedules[0].StartTime.ToString("HH:mm") – @TodaySchedules[0].EndTime.ToString("HH:mm")</strong></span></div><div><i class="fas fa-snowflake"></i><span><small>AC status</small><strong><span class='room-status @AcStatusTone(AssignedRooms.FirstOrDefault()?.AcStatus ?? "Idle")'>@AcStatusLabel(AssignedRooms.FirstOrDefault()?.AcStatus ?? "Idle")</span></strong></span></div></div><button class="primary-button" @onclick='() => Navigate("active")'>Open active class <i class="fas fa-arrow-right"></i></button> }
                    </article>
                    <article class="panel next-class-panel"><span class="eyebrow">BIOMETRIC ACCESS</span><h3>@profile.FingerprintTemplateCount fingerprint(s) enrolled</h3><p>Use your device PIN on the fingerprint terminal to enroll or update fingerprints.</p><button class="secondary-button" @onclick='() => Navigate("profile")'>Open profile</button></article>
                </div>
            }
            else if (active == "profile")
            {
                <div class="page-intro"><p>MY PROFILE PROCESS</p><h2>Profile & access details</h2><span>Your account is loaded from the teacher record created by the administrator.</span></div>
                <div class="dashboard-grid profile-grid"><article class="panel profile-summary"><div class="profile-portrait">@Initials</div><h3>@TeacherName</h3>@if (!string.IsNullOrWhiteSpace(profile.Email)) { <p>@profile.Email</p> }@if (!string.IsNullOrWhiteSpace(profile.Phone)) { <p><small>Mobile</small> <strong>@profile.Phone</strong></p> }@if (!string.IsNullOrWhiteSpace(profile.EmployeeNumber)) { <p><small>Employee #</small> <strong>@profile.EmployeeNumber</strong></p> }@if (!string.IsNullOrWhiteSpace(profile.DevicePin)) { <p><small>Device PIN</small> <strong>@profile.DevicePin</strong></p> }<span class="verified-badge"><i class="fas fa-fingerprint"></i>@profile.FingerprintTemplateCount fingerprints enrolled</span><hr /><small>ACCOUNT ACCESS</small><strong><i class="fas fa-shield-halved"></i>Active teacher account</strong><p class="form-help">Use your device PIN on the fingerprint terminal to enroll or update fingerprints.</p></article><article class="panel"><span class="eyebrow">EDIT PROFILE</span><h3>Your information</h3><div class="form-grid"><label>Full name<input @bind="profileName" /></label><label>Employee number<input value="@(profile.EmployeeNumber ?? string.Empty)" readonly /></label><label>Device PIN<input @bind="profilePin" inputmode="numeric" maxlength="6" pattern="[0-9]*" title="4–6 digits for the fingerprint terminal" /><small class="form-help">Enter this PIN on the device to enroll fingerprints.</small></label><label>Mobile number<input @bind="profilePhone" maxlength="11" inputmode="numeric" pattern="09[0-9]{9}" placeholder="09xxxxxxxxx" /><small class="form-help">Required. Format: 09xxxxxxxxx</small></label><label>Email<input @bind="profileEmail" type="email" /><small class="form-help">Optional</small></label><label>New password<input type="password" @bind="profilePassword" placeholder="Leave blank to keep current password" /></label></div><div class="form-actions"><button class="primary-button" @onclick="SaveProfile">Save profile changes</button></div></article></div>
            }
            else if (active == "schedule")
            {
                <div class="page-intro"><p>MY SCHEDULE PROCESS</p><h2>Your scheduled classes</h2><span>Schedules are assigned by the administrator for your account.</span></div>
                <article class="panel"><div class="teacher-schedule-list">@if (schedules.Count == 0) { <p class="form-help">No classes are assigned to your account yet.</p> } @foreach (var item in PagedSchedules) { <div class='teacher-schedule-item @(item.ScheduleDate == Today ? "is-live" : string.Empty)'><div class="schedule-time"><strong>@item.StartTime.ToString("HH:mm")</strong><span>@item.EndTime.ToString("HH:mm")</span></div><div class="schedule-line"></div><div class="schedule-info"><span class='status-badge @(item.ScheduleDate == Today ? "active" : "neutral")'>@item.ScheduleDate.ToString("MMM d")</span><span class='status-badge @(item.ScheduleKind == "Makeup" ? "pending" : "neutral")'>@item.ScheduleKind</span><h3>@item.SubjectName</h3><p><i class="fas fa-door-open"></i>@item.ClassroomName <i class="fas fa-layer-group"></i>@(item.SemesterName ?? "—") <i class="fas fa-users"></i>@item.ClassroomCapacity students</p></div></div> }</div><ListPager State="schedulePager" TotalCount="schedules.Count" /></article>
            }
            else if (active == "attendance")
            {
                <div class="page-intro"><p>ATTENDANCE HISTORY PROCESS</p><h2>Your biometric attendance history</h2><span>Outcomes come from punches vs your schedule: On time, Late, Absent, or Missing time-out.</span></div>
                <article class="panel"><div class="data-table-wrap"><table class="data-table"><thead><tr><th>Date</th><th>Classroom</th><th>Time in</th><th>Time out</th><th>Verification</th><th>Outcome</th></tr></thead><tbody>@if (attendance.Count == 0) { <tr><td colspan="6">No attendance record has been created.</td></tr> } @foreach (var item in PagedAttendance) { <tr><td><strong>@SchoolClock.Format(item.TimeIn, "MMM d, yyyy")</strong></td><td>@item.ClassroomName</td><td>@(item.Outcome == AttendanceOutcomes.Absent ? "—" : SchoolClock.Format(item.TimeIn, "HH:mm"))</td><td>@(item.Outcome == AttendanceOutcomes.Absent ? "—" : SchoolClock.Format(item.TimeOut, "HH:mm"))</td><td><span class="verified-badge"><i class="fas fa-fingerprint"></i>@item.VerificationMethod</span></td><td><span class='status-badge @AttendanceOutcomes.BadgeClass(item.Outcome, item.Status)'>@AttendanceOutcomes.Display(item.Outcome, item.Status)</span></td></tr> }</tbody></table></div><ListPager State="attendancePager" TotalCount="attendance.Count" /></article>
            }
            else if (active == "classroom")
            {
                <div class="page-intro"><p>CLASSROOM TEMPERATURE PROCESS</p><h2>Assigned classroom temperature</h2><span>You may send a target command only for a classroom assigned to you today.</span></div>
                <article class="panel"><div class="form-grid"><label>Classroom<select @bind="selectedClassroomId"><option value="0">Select a scheduled room</option>@foreach (var room in AssignedRooms) { <option value="@room.Id">@room.Name</option> }</select></label><label>Target temperature<input type="number" min="16" max="30" @bind="targetTemp" /></label></div><div class="form-actions"><button class="primary-button" disabled="@(selectedClassroomId == 0)" @onclick="ApplyTarget"><i class="fas fa-paper-plane"></i>Send target command</button><button class="danger-outline-button" disabled="@(selectedClassroomId == 0)" @onclick="Shutdown">Hard shutdown</button></div></article>
                <article class="panel"><span class="eyebrow">RECENT TEMPERATURE LOGS</span><div class="data-table-wrap"><table class="data-table"><thead><tr><th>Classroom</th><th>Event</th><th>Target</th><th>Recorded</th></tr></thead><tbody>@if (temperatureLogs.Count == 0) { <tr><td colspan="4">No temperature commands have been logged.</td></tr> } @foreach (var log in PagedTemperatureLogs) { <tr><td>@log.ClassroomName</td><td>@log.EventType</td><td>@(log.TargetTemperature is null ? "—" : $"{log.TargetTemperature}°C")</td><td>@SchoolClock.Format(log.RecordedAt, "MMM d HH:mm")</td></tr> }</tbody></table></div><ListPager State="temperatureLogPager" TotalCount="temperatureLogs.Count" /></article>
            }
            else if (active == "active")
            {
                <div class="page-intro"><p>ACTIVE CLASS AUTOMATION</p><h2>Start and end your scheduled class</h2><span>Starting records a time-in and cooling event; ending records time-out and turns the classroom status off.</span></div>
                <div class="dashboard-grid active-class-grid"><article class="panel"><span class="eyebrow">TODAY'S SCHEDULE</span>@if (TodaySchedules.Count == 0) { <p class="form-help">No class is scheduled for today.</p> } @foreach (var schedule in PagedTodaySchedules) { <div class="request-summary"><span class="request-type-icon"><i class="fas fa-chalkboard-user"></i></span><div><strong>@schedule.SubjectName</strong><small>@schedule.ClassroomName · @schedule.StartTime.ToString("HH:mm") – @schedule.EndTime.ToString("HH:mm")</small></div><button class="primary-button" disabled="@(ActiveAttendance is not null)" @onclick='() => StartClass(schedule.Id)'>Start</button></div> }<ListPager State="todaySchedulePager" TotalCount="TodaySchedules.Count" /></article><article class="panel class-session-card"><span class="eyebrow">ACTIVE ATTENDANCE</span><h3>@(ActiveAttendance?.ClassroomName ?? "No active class")</h3><p>@(ActiveAttendance is null ? "Select a schedule to record biometric time-in." : $"Started {SchoolClock.Format(ActiveAttendance.TimeIn, "HH:mm")}")</p><button class="danger-outline-button" disabled="@(ActiveAttendance is null)" @onclick="EndClass">End class</button></article></div>
            }
        </section>
    </main>
</div>

@code {
    private string active = "overview", message = string.Empty, profileName = string.Empty, profileEmail = string.Empty, profilePhone = string.Empty, profilePin = string.Empty, profilePassword = string.Empty;
    private bool sidebarOpen, isLoading;
    private int targetTemp = 22;
    private long selectedClassroomId;
    private readonly ListPageState schedulePager = new();
    private readonly ListPageState attendancePager = new();
    private readonly ListPageState temperatureLogPager = new();
    private readonly ListPageState todaySchedulePager = new();
    private TeacherProfileEntry? profile;
    private List<ScheduleDirectoryEntry> schedules = new();
    private List<ClassroomEntry> classrooms = new();
    private List<AttendanceLogEntry> attendance = new();
    private List<TemperatureLogEntry> temperatureLogs = new();
    private CancellationTokenSource? liveRefreshCts;

    private string TeacherName => profile?.DisplayName ?? "Teacher";
    private string Initials => string.Concat(TeacherName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(word => char.ToUpperInvariant(word[0])));
    private DateOnly Today => SchoolClock.Today(SchoolTime.Value);
    private List<ScheduleDirectoryEntry> TodaySchedules => schedules.Where(schedule => schedule.ScheduleDate == Today).ToList();
    private IReadOnlyList<ScheduleDirectoryEntry> PagedSchedules => schedulePager.Slice(schedules);
    private IReadOnlyList<AttendanceLogEntry> PagedAttendance => attendancePager.Slice(attendance);
    private IReadOnlyList<TemperatureLogEntry> PagedTemperatureLogs => temperatureLogPager.Slice(temperatureLogs);
    private IReadOnlyList<ScheduleDirectoryEntry> PagedTodaySchedules => todaySchedulePager.Slice(TodaySchedules);
    private AttendanceLogEntry? ActiveAttendance => attendance.FirstOrDefault(item => item.Status == "Active");
    private List<AttendanceLogEntry> TodayAttendance => attendance.Where(item => DateOnly.FromDateTime(item.TimeIn) == Today).ToList();
    private List<ClassroomEntry> AssignedRooms => TodaySchedules.GroupBy(schedule => schedule.ClassroomId).Select(group =>
    {
        var room = classrooms.FirstOrDefault(item => item.Id == group.Key);
        return new ClassroomEntry(
            group.Key,
            group.First().ClassroomName,
            group.First().ClassroomCapacity,
            room?.TargetTemperature ?? 22,
            room?.CurrentTemperature,
            room?.AcStatus ?? "Idle",
            true);
    }).ToList();
    private string Title => active switch { "profile" => "My profile", "schedule" => "My schedule", "attendance" => "Attendance history", "classroom" => "Classroom temperature", "active" => "Active class", _ => "Dashboard overview" };
    private string NavClass(string section) => $"sc-nav-item {(active == section ? "active" : string.Empty)}";
    private static string AcStatusTone(string status) =>
        status is "Cooling" or "Override" or "Remote" ? "online" : "idle";
    private static string AcStatusLabel(string status) => status switch
    {
        "Cooling" => "Cooling",
        "Override" => "Override",
        "Remote" => "Remote on",
        "Off" => "Off",
        "Idle" => "Off",
        _ => status
    };

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        liveRefreshCts = new CancellationTokenSource();
        _ = RunLiveRefreshLoopAsync(liveRefreshCts.Token);
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        try
        {
            var profileTask = AuthService.GetMyTeacherProfileAsync();
            var schedulesTask = AuthService.GetMyTeacherSchedulesAsync();
            var classroomsTask = AuthService.GetClassroomsAsync();
            var attendanceTask = AuthService.GetAttendanceLogsAsync();
            var temperatureLogsTask = AuthService.GetTemperatureLogsAsync();
            await Task.WhenAll(profileTask, schedulesTask, classroomsTask, attendanceTask, temperatureLogsTask);
            profile = await profileTask;
            if (profile is not null)
            {
                profileName = profile.DisplayName;
                profileEmail = profile.Email ?? string.Empty;
                profilePhone = profile.Phone ?? string.Empty;
                profilePin = profile.DevicePin ?? string.Empty;
            }
            schedules = (await schedulesTask).ToList();
            classrooms = (await classroomsTask).ToList();
            attendance = (await attendanceTask).ToList();
            temperatureLogs = (await temperatureLogsTask).ToList();
            selectedClassroomId = TodaySchedules.FirstOrDefault()?.ClassroomId ?? 0;
        }
        catch { Toast("Your dashboard data could not be loaded."); }
        finally { isLoading = false; }
    }

    private async Task RefreshLiveStateAsync()
    {
        try
        {
            var classroomsTask = AuthService.GetClassroomsAsync();
            var attendanceTask = AuthService.GetAttendanceLogsAsync();
            var temperatureLogsTask = AuthService.GetTemperatureLogsAsync();
            await Task.WhenAll(classroomsTask, attendanceTask, temperatureLogsTask);
            classrooms = (await classroomsTask).ToList();
            attendance = (await attendanceTask).ToList();
            temperatureLogs = (await temperatureLogsTask).ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private async Task RunLiveRefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (active is "overview" or "classroom" or "active" or "attendance")
                {
                    await RefreshLiveStateAsync();
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task Navigate(string section)
    {
        active = section;
        sidebarOpen = false;
        if (section is "overview" or "classroom" or "active" or "attendance")
        {
            await RefreshLiveStateAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (liveRefreshCts is null)
        {
            return;
        }

        await liveRefreshCts.CancelAsync();
        liveRefreshCts.Dispose();
        liveRefreshCts = null;
    }

    private void ToggleSidebar() => sidebarOpen = !sidebarOpen;
    private void Toast(string value) => message = value;
    private async Task Logout() { await AuthService.LogoutAsync(); await AuthStateProvider.NotifyUserLogoutAsync(); Navigation.NavigateTo("/auth/logout", true); }

    private async Task SaveProfile()
    {
        var result = await AuthService.UpdateMyTeacherProfileAsync(new UpdateTeacherProfileRequest(profileName, string.IsNullOrWhiteSpace(profileEmail) ? null : profileEmail, profilePhone, profilePin, profilePassword));
        if (!result.Succeeded) { Toast(result.Error ?? "Profile could not be updated."); return; }
        profilePassword = string.Empty;
        await ReloadAsync();
        Toast("Your profile was updated.");
    }

    private async Task ApplyTarget()
    {
        var result = await AuthService.SetTemperatureAsync(new SetTemperatureRequest(selectedClassroomId, targetTemp, "TargetSet"));
        if (!result.Succeeded) { Toast(result.Error ?? "Temperature command could not be recorded."); return; }
        temperatureLogs = (await AuthService.GetTemperatureLogsAsync()).ToList();
        Toast($"A {targetTemp}°C command was recorded for the classroom.");
    }

    private async Task Shutdown()
    {
        var result = await AuthService.SetTemperatureAsync(new SetTemperatureRequest(selectedClassroomId, targetTemp, "HardShutdown", "Teacher emergency shutdown"));
        if (!result.Succeeded) { Toast(result.Error ?? "Shutdown command could not be recorded."); return; }
        temperatureLogs = (await AuthService.GetTemperatureLogsAsync()).ToList();
        Toast("Hard shutdown was recorded for the classroom.");
    }

    private async Task StartClass(long scheduleId)
    {
        var result = await AuthService.StartMyClassAsync(scheduleId);
        if (!result.Succeeded) { Toast(result.Error ?? "Class could not be started."); return; }
        await ReloadAsync();
        Toast("Time-in and classroom cooling were recorded.");
    }

    private async Task EndClass()
    {
        var result = await AuthService.EndMyClassAsync();
        if (!result.Succeeded) { Toast(result.Error ?? "Class could not be ended."); return; }
        await ReloadAsync();
        Toast("Time-out and classroom shutdown were recorded.");
    }
}
