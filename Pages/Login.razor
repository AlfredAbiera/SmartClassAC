@page "/login"

@using Microsoft.AspNetCore.Components.Authorization

@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject CustomAuthStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject ILogger<Login> Logger

<PageTitle>Login - SmartClass AC</PageTitle>

<div class="login-page">

    <!-- =====================================================
         BACKGROUND
         ===================================================== -->

    <div class="login-background">

        <div class="glow glow-1"></div>
        <div class="glow glow-2"></div>
        <div class="glow glow-3"></div>

        <div class="snowflakes" aria-hidden="true">
            <div class="snowflake snowflake-1">❄</div>
            <div class="snowflake snowflake-2">❄</div>
            <div class="snowflake snowflake-3">❄</div>
            <div class="snowflake snowflake-4">❄</div>
            <div class="snowflake snowflake-5">❄</div>
            <div class="snowflake snowflake-6">❄</div>
            <div class="snowflake snowflake-7">❄</div>
            <div class="snowflake snowflake-8">❄</div>
        </div>

    </div>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <main class="login-content">


        <!-- =================================================
             LOGIN CARD
             ================================================= -->

        <section class="login-card">

            <!-- Header -->
            <div class="login-header">

                <div class="login-icon">
                    <i class="fas fa-snowflake"></i>
                </div>

                <h1>Welcome</h1>

                <p>
                    Sign in to your SmartClass AC account
                </p>

            </div>


            <!-- Error Message -->
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="login-error">

                    <i class="fas fa-circle-exclamation"></i>

                    <span>
                        @errorMessage
                    </span>

                </div>
            }


            <!-- Login Form -->
            <form method="post" action="/auth/login" @ref="loginForm">

                <!-- Username -->
                <div class="form-field">

                    <label for="username">
                        Username / Email
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-user input-icon"></i>

                        <input id="username"
                               type="text"
                               class="login-input"
                               placeholder="Enter your username"
                               autocomplete="username"
                               name="username" />

                    </div>

                </div>


                <!-- Password -->
                <div class="form-field">

                    <div class="password-label">

                        <label for="password">
                            Password
                        </label>

                        <a href="/forgot-password">Forgot password?</a>

                    </div>

                    <div class="input-wrapper">

                        <i class="fas fa-lock input-icon"></i>

                        <input id="password"
                               type="@(showPassword ? "text" : "password")"
                               class="login-input login-input-password"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               name="password" />

                        <button type="button"
                                class="password-peek"
                                aria-label="@(showPassword ? "Hide password" : "Show password")"
                                title="@(showPassword ? "Hide password" : "Show password")"
                                @onclick="TogglePasswordVisibility">
                            <i class="fas @(showPassword ? "fa-eye-slash" : "fa-eye")" aria-hidden="true"></i>
                        </button>

                    </div>

                </div>


                <div class="remember-row">
                    <label class="remember-label">
                        <input type="checkbox" id="remember-username" disabled />
                        <span class="custom-checkbox" aria-hidden="true"></span>
                        <span>Remember username on this device</span>
                    </label>
                    <p id="remember-error" class="remember-error" role="alert">@rememberError</p>
                </div>

                <!-- Login Button -->
                <button type="submit"
                        class="login-submit"
                        disabled="@isLoading">

                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm"
                              role="status"
                              aria-hidden="true">
                        </span>

                        <span>
                            Signing in...
                        </span>
                    }
                    else
                    {
                        <span>
                            Sign In
                        </span>

                        <i class="fas fa-arrow-right"></i>
                    }

                </button>

            </form>

        </section>


        <!-- =================================================
             INFORMATION PANEL
             ================================================= -->

        <section class="login-info">


            <!-- Decorative Circle -->
            <div class="info-decoration info-decoration-1"></div>
            <div class="info-decoration info-decoration-2"></div>


            <!-- Heading -->
            <h2>
                Smarter classrooms.
                <span>Better learning.</span>
            </h2>


            <p class="info-description">

                SmartClass AC brings intelligent classroom cooling,
                secure teacher authentication, and automated attendance
                together in one modern platform.

            </p>


            <!-- Main Visual -->
            <div class="smart-ac-visual">

                <div class="visual-glow"></div>

                <div class="ac-device">

                    <div class="ac-device-top">

                        <span class="ac-brand">
                            SMARTCLASS
                        </span>

                        <span class="ac-indicator"></span>

                    </div>

                    <div class="ac-display">
                        24°
                        <span>C</span>
                    </div>

                    <div class="ac-air-lines">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>

                </div>


                <!-- Temperature Bubble -->
                <div class="temperature-card">

                    <div class="temperature-icon">
                        <i class="fas fa-temperature-low"></i>
                    </div>

                    <div>
                        <small>Classroom Temperature</small>
                        <strong>24°C</strong>
                    </div>

                    <span class="cooling-status">
                        <i class="fas fa-circle"></i>
                        Optimal
                    </span>

                </div>

            </div>


            <!-- Features -->
            <div class="info-features">


                <!-- Feature 1 -->
                <div class="info-feature">

                    <div class="info-feature-icon blue">
                        <i class="fas fa-snowflake"></i>
                    </div>

                    <div class="info-feature-content">

                        <strong>
                            Smart AC Control
                        </strong>

                        <small>
                            Intelligent classroom cooling
                        </small>

                    </div>

                    <i class="fas fa-check feature-check"></i>

                </div>


                <!-- Feature 2 -->
                <div class="info-feature">

                    <div class="info-feature-icon purple">
                        <i class="fas fa-fingerprint"></i>
                    </div>

                    <div class="info-feature-content">

                        <strong>
                            Biometric Authentication
                        </strong>

                        <small>
                            Secure teacher verification
                        </small>

                    </div>

                    <i class="fas fa-check feature-check"></i>

                </div>


                <!-- Feature 3 -->
                <div class="info-feature">

                    <div class="info-feature-icon cyan">
                        <i class="fas fa-clipboard-check"></i>
                    </div>

                    <div class="info-feature-content">

                        <strong>
                            Automated Attendance
                        </strong>

                        <small>
                            Accurate attendance tracking
                        </small>

                    </div>

                    <i class="fas fa-check feature-check"></i>

                </div>

            </div>


            <!-- Bottom Message -->
            <div class="info-bottom">

                <div class="info-bottom-icon">
                    <i class="fas fa-wand-magic-sparkles"></i>
                </div>

                <div>
                    <strong>Everything in one place</strong>

                    <span>
                        Built for efficient and connected classrooms.
                    </span>
                </div>

            </div>

        </section>

    </main>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer class="login-footer">

        <span>
            © 2026 SmartClass AC
        </span>

        <span class="footer-dot">
            •
        </span>

        <span>
            Smart Cooling for Smart Classrooms
        </span>

    </footer>

</div>


@code {

    private ElementReference loginForm;
    private string rememberError = string.Empty;

    private bool showPassword;

    private bool isLoading = false;

    private string errorMessage = string.Empty;


    protected override void OnInitialized()
    {
        if (Navigation.Uri.Contains("error=signin", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Invalid username or password.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            await JS.InvokeVoidAsync("smartClassRememberUsername.initialize", loginForm);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Unable to initialize the remember username option.");
            rememberError = "Remember username could not be initialized. Reload the page and try again.";
            StateHasChanged();
        }
    }

    private void TogglePasswordVisibility() => showPassword = !showPassword;

}


<style>

    /* =====================================================
               GLOBAL PAGE
               ===================================================== */

    .login-page {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: radial-gradient( circle at 8% 15%, rgba(66, 165, 245, 0.16), transparent 30% ), radial-gradient( circle at 92% 75%, rgba(26, 115, 232, 0.13), transparent 32% ), linear-gradient( 135deg, #f4faff 0%, #e8f4ff 50%, #f6fbff 100% );
        color: #172033;
    }


    /* =====================================================
               BACKGROUND
               ===================================================== */

    .login-background {
        position: fixed;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }


    .glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.35;
    }


    .glow-1 {
        width: 340px;
        height: 340px;
        background: #42a5f5;
        top: -120px;
        left: -120px;
    }


    .glow-2 {
        width: 400px;
        height: 400px;
        background: #1a73e8;
        right: -180px;
        top: 20%;
    }


    .glow-3 {
        width: 300px;
        height: 300px;
        background: #90caf9;
        left: 35%;
        bottom: -150px;
    }


    /* =====================================================
               SNOWFLAKES
               ===================================================== */

    .snowflake {
        position: absolute;
        top: -10%;
        color: rgba(26, 115, 232, 0.12);
        animation-name: loginSnowfall;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
        user-select: none;
    }


    .snowflake-1 {
        left: 5%;
        font-size: 1.5rem;
        animation-duration: 13s;
    }


    .snowflake-2 {
        left: 18%;
        font-size: 2.2rem;
        animation-duration: 17s;
        animation-delay: 2s;
    }


    .snowflake-3 {
        left: 35%;
        font-size: 1.7rem;
        animation-duration: 11s;
        animation-delay: 4s;
    }


    .snowflake-4 {
        left: 50%;
        font-size: 2.5rem;
        animation-duration: 18s;
        animation-delay: 1s;
    }


    .snowflake-5 {
        left: 65%;
        font-size: 1.8rem;
        animation-duration: 14s;
        animation-delay: 5s;
    }


    .snowflake-6 {
        left: 78%;
        font-size: 2.4rem;
        animation-duration: 16s;
        animation-delay: 3s;
    }


    .snowflake-7 {
        left: 90%;
        font-size: 1.5rem;
        animation-duration: 12s;
        animation-delay: 6s;
    }


    .snowflake-8 {
        left: 42%;
        font-size: 1.3rem;
        animation-duration: 20s;
        animation-delay: 7s;
    }


    @@keyframes loginSnowfall {

        0% {
            transform: translateY(0) rotate(0deg);
            opacity: 0;
        }

        15% {
            opacity: 0.8;
        }

        100% {
            transform: translateY(110vh) rotate(720deg);
            opacity: 0;
        }
    }


    /* =====================================================
               MAIN CONTENT
               ===================================================== */

    .login-content {
        position: relative;
        z-index: 2;
        flex: 1;
        width: 100%;
        max-width: 1220px;
        margin: 0 auto;
        padding: 28px 30px 55px;
        box-sizing: border-box;
        display: grid;
        grid-template-columns: minmax(380px, 480px) minmax(400px, 1fr);
        align-items: stretch;
        align-content: center;
        justify-content: center;
        gap: 90px;
    }


    /* =====================================================
               LOGIN CARD
               ===================================================== */

    .login-card {
        width: 100%;
        padding: 32px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        box-sizing: border-box;
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        border: 1px solid rgba(255, 255, 255, 0.95);
        border-radius: var(--smart-radius);
        box-shadow: 0 30px 80px rgba(26, 115, 232, 0.13), 0 5px 20px rgba(26, 115, 232, 0.05);
        animation: cardAppear 0.7s ease-out;
    }


    @@keyframes cardAppear {

        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =====================================================
               LOGIN HEADER
               ===================================================== */

    .login-header {
        margin-bottom: 28px;
        text-align: center;
    }


    .login-icon {
        width: 68px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 17px;
        border-radius: var(--smart-radius);
        color: white;
        font-size: 1.7rem;
        background: linear-gradient( 135deg, #1a73e8, #42a5f5 );
        box-shadow: 0 13px 30px rgba(26, 115, 232, 0.24);
        animation: loginIconFloat 4s ease-in-out infinite;
    }


    @@keyframes loginIconFloat {

        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }
    }


    .login-header h1 {
        margin: 0 0 7px;
        color: #172033;
        font-size: 1.95rem;
        font-weight: 750;
        letter-spacing: -0.025em;
    }


    .login-header p {
        margin: 0;
        color: #667085;
        font-size: 0.9rem;
    }


    /* =====================================================
               ERROR
               ===================================================== */

    .login-error {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 13px 15px;
        margin-bottom: 21px;
        border-radius: var(--smart-radius);
        color: #b42318;
        background: rgba(220, 53, 69, 0.08);
        border: 1px solid rgba(220, 53, 69, 0.12);
        font-size: 0.88rem;
        line-height: 1.4;
    }


        .login-error i {
            margin-top: 2px;
        }


    /* =====================================================
               FORM
               ===================================================== */

    .form-field {
        margin-bottom: 20px;
    }


        .form-field label {
            display: block;
            margin-bottom: 8px;
            color: #344054;
            font-size: 0.87rem;
            font-weight: 650;
        }


    .password-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }


        .password-label label {
            margin-bottom: 8px;
        }


        .password-label a {
            margin-bottom: 8px;
            color: #1a73e8;
            text-decoration: none;
            font-size: 0.79rem;
            font-weight: 650;
        }


            .password-label a:hover {
                text-decoration: underline;
            }


    /* =====================================================
               INPUT
               ===================================================== */

    .input-wrapper {
        position: relative;
    }


    .input-icon {
        position: absolute;
        top: 50%;
        left: 17px;
        transform: translateY(-50%);
        color: #98a2b3;
        font-size: 0.92rem;
        pointer-events: none;
        transition: color 0.2s ease;
    }


    .login-input {
        width: 100%;
        height: 52px;
        padding: 0 16px 0 46px;
        box-sizing: border-box;
        border: 1px solid #d0d5dd;
        border-radius: var(--smart-radius);
        outline: none;
        background: rgba(255, 255, 255, 0.78);
        color: #172033;
        font-size: 0.93rem;
        transition: all 0.25s ease;
    }


        .login-input::placeholder {
            color: #98a2b3;
        }


        .login-input:focus {
            border-color: #1a73e8;
            background: white;
            box-shadow: 0 0 0 4px rgba(26, 115, 232, 0.10);
        }


    .login-input-password {
        padding-right: 48px;
    }


    .password-peek {
        position: absolute;
        top: 50%;
        right: 10px;
        display: grid;
        width: 36px;
        height: 36px;
        place-items: center;
        transform: translateY(-50%);
        border: 0;
        border-radius: var(--smart-radius);
        background: transparent;
        color: #98a2b3;
        cursor: pointer;
        font-size: 0.95rem;
        transition: color 0.2s ease, background 0.2s ease;
    }


        .password-peek:hover,
        .password-peek:focus-visible {
            color: #1a73e8;
            background: rgba(26, 115, 232, 0.08);
            outline: none;
        }


    .input-wrapper:focus-within .input-icon {
        color: #1a73e8;
    }


    .input-wrapper:focus-within .password-peek {
        color: #1a73e8;
    }


    /* =====================================================
               REMEMBER ME
               ===================================================== */

    .remember-row {
        margin: 3px 0 16px;
    }


    .remember-label {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin: 0;
        color: #667085;
        cursor: pointer;
        font-size: 0.84rem;
        font-weight: 500;
    }


        .remember-label input {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
            pointer-events: none;
        }


    .custom-checkbox {
        width: 19px;
        height: 19px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1.5px solid #d0d5dd;
        border-radius: var(--smart-radius);
        background: white;
        transition: all 0.2s ease;
    }


    .remember-label input:checked + .custom-checkbox {
        background: #1a73e8;
        border-color: #1a73e8;
    }

    .remember-label input:focus-visible + .custom-checkbox {
        outline: 2px solid #1a73e8;
        outline-offset: 2px;
    }

    .remember-label input:disabled + .custom-checkbox {
        opacity: 0.5;
    }

    .remember-error {
        margin: 6px 0 0;
        font-size: 0.8rem;
        color: #b42318;
    }

    .remember-error:empty {
        display: none;
    }


        .remember-label input:checked + .custom-checkbox::after {
            content: "✓";
            color: white;
            font-size: 0.75rem;
            font-weight: 700;
        }


    /* =====================================================
               LOGIN BUTTON
               ===================================================== */

    .login-submit {
        width: 100%;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: none;
        border-radius: var(--smart-radius);
        color: white;
        font-size: 0.94rem;
        font-weight: 650;
        cursor: pointer;
        background: linear-gradient( 135deg, #1a73e8, #0d47a1 );
        box-shadow: 0 11px 27px rgba(26, 115, 232, 0.25);
        transition: all 0.25s ease;
    }


        .login-submit:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 15px 34px rgba(26, 115, 232, 0.34);
        }


        .login-submit:active:not(:disabled) {
            transform: translateY(0);
        }


        .login-submit:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }


    /* =====================================================
               INFORMATION PANEL
               ===================================================== */

    .login-info {
        position: relative;
        width: 100%;
        max-width: 560px;
        padding: 0;
        animation: infoAppear 0.8s ease-out;
    }


    @@keyframes infoAppear {

        from {
            opacity: 0;
            transform: translateX(25px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }


    /* =====================================================
               INFO DECORATIONS
               ===================================================== */

    .info-decoration {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
    }


    .info-decoration-1 {
        width: 180px;
        height: 180px;
        top: 5px;
        right: -50px;
        border: 1px solid rgba(26, 115, 232, 0.10);
        box-shadow: inset 0 0 40px rgba(26, 115, 232, 0.03);
    }


    .info-decoration-2 {
        width: 90px;
        height: 90px;
        bottom: 30px;
        left: -45px;
        background: rgba(66, 165, 245, 0.06);
        border: 1px solid rgba(66, 165, 245, 0.08);
    }


    /* =====================================================
               INFO HEADING
               ===================================================== */

    .login-info h2 {
        position: relative;
        z-index: 2;
        max-width: 550px;
        margin: 0 0 14px;
        color: #172033;
        font-size: clamp(2rem, 3.2vw, 2.7rem);
        font-weight: 780;
        line-height: 1.08;
        letter-spacing: -0.045em;
    }


        .login-info h2 span {
            display: block;
            background: linear-gradient( 90deg, #1a73e8, #42a5f5 );
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }


    .info-description {
        position: relative;
        z-index: 2;
        max-width: 510px;
        margin: 0 0 16px;
        color: #667085;
        font-size: 0.9rem;
        line-height: 1.6;
    }


    /* =====================================================
               SMART AC VISUAL
               ===================================================== */

    .smart-ac-visual {
        position: relative;
        height: 150px;
        margin: 0 0 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--smart-radius);
        overflow: hidden;
        background: linear-gradient( 135deg, rgba(255, 255, 255, 0.72), rgba(225, 242, 253, 0.62) );
        border: 1px solid rgba(255, 255, 255, 0.9);
        box-shadow: 0 15px 40px rgba(26, 115, 232, 0.08);
        backdrop-filter: blur(15px);
    }


        .smart-ac-visual::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( 90deg, transparent 0%, rgba(255, 255, 255, 0.55) 50%, transparent 100% );
            opacity: 0.55;
        }


    .visual-glow {
        position: absolute;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: rgba(66, 165, 245, 0.18);
        filter: blur(35px);
    }


    /* =====================================================
               AC DEVICE
               ===================================================== */

    .ac-device {
        position: relative;
        z-index: 2;
        width: 270px;
        height: 105px;
        padding: 14px 18px;
        box-sizing: border-box;
        border-radius: var(--smart-radius);
        background: linear-gradient( 145deg, #ffffff, #e9f4fc );
        border: 1px solid rgba(255, 255, 255, 0.95);
        box-shadow: 0 18px 35px rgba(30, 90, 140, 0.14);
        animation: acFloat 5s ease-in-out infinite;
    }


    @@keyframes acFloat {

        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }
    }


    .ac-device-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: #98a2b3;
        font-size: 0.48rem;
        font-weight: 800;
        letter-spacing: 0.12em;
    }


    .ac-indicator {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.10);
    }


    .ac-display {
        margin-top: 12px;
        color: #1a73e8;
        font-size: 2rem;
        font-weight: 750;
        line-height: 1;
