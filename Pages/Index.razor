                            Access Dashboard

                            <i class="fas fa-arrow-right ms-2"></i>

                        </a>

                    </div>

                </div>


                <!-- ABOUT VISUAL -->
                <div class="col-lg-6">

                    <div class="about-visual">

                        <div class="about-main-circle">

                            <i class="fas fa-school"></i>

                        </div>


                        <div class="floating-icon icon-1">

                            <i class="fas fa-snowflake"></i>

                        </div>


                        <div class="floating-icon icon-2">

