     ========================================================= -->

<div class="landing-wrapper">

    <div class="container">

        <!-- =====================================================
             HERO SECTION
             ===================================================== -->

        <div class="row hero-section align-items-center min-vh-100">

            <!-- HERO TEXT -->
            <div class="col-lg-7 text-center text-lg-start">

                <div class="badge hero-badge px-4 py-2 rounded-pill mb-4">

                    <i class="fas fa-bolt me-2"></i>

                    Next-Gen Classroom Climate

                </div>


                <h1 class="display-3 fw-bold mb-3 hero-title">

                    SmartClass
                    <span class="text-primary">AC</span>

                </h1>


                <p class="lead mb-4 text-muted hero-description">

                    Secure smart-classroom control with
                    <strong>administrator-managed teacher accounts</strong>,
                    biometric access, and automated attendance.

                </p>


                <!-- BUTTONS -->
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">

                    <a href="/login"
                       class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow-lg hero-button">

                        <i class="fas fa-right-to-bracket me-2"></i>

                        Sign in securely

                    </a>


                    <a href="#features"
                       class="btn btn-outline-secondary btn-lg px-5 py-3 rounded-pill explore-button">

                        <i class="fas fa-chevron-down me-2"></i>

                        Explore

                    </a>

                </div>

                <div class="comfort-control" aria-label="Classroom comfort demonstration">
                    <div class="comfort-control-header">
                        <span><i class="fas fa-sliders me-2"></i>Try the comfort control</span>
                        <output id="targetTemperature" for="temperatureControl">22°C</output>
                    </div>
                    <input id="temperatureControl"
                           class="temperature-slider"
                           type="range"
                           min="18"
                           max="28"
                           value="22"
                           aria-label="Target classroom temperature"
                           oninput="updateClassroomTemperature(this.value)" />
                    <small id="comfortMessage" aria-live="polite">Balanced cooling for focused learning.</small>
                </div>


                <div class="access-assurance" aria-label="Secure account access">
                    <div><i class="fas fa-right-to-bracket"></i><span><strong>One secure sign-in</strong><small>No public sign-up or role selection</small></span></div>
                    <div><i class="fas fa-user-shield"></i><span><strong>Admin-controlled access</strong><small>Only the administrator enrolls teachers</small></span></div>
                    <div><i class="fas fa-compass"></i><span><strong>Automatic workspace</strong><small>Your stored role opens the right dashboard</small></span></div>
