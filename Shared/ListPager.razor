@if (TotalCount > 0)
{
    <nav class="list-pager" aria-label="Pagination">
        <span class="list-pager-summary">@State.Summary(TotalCount)</span>
        <div class="list-pager-controls">
            <button type="button" class="secondary-button list-pager-btn" disabled="@(!State.CanPrev)" @onclick="OnPrev" aria-label="Previous page"><i class="fas fa-chevron-left"></i></button>
            <span class="list-pager-page">Page @State.Page of @State.TotalPages(TotalCount)</span>
            <button type="button" class="secondary-button list-pager-btn" disabled="@(!State.CanNext(TotalCount))" @onclick="OnNext" aria-label="Next page"><i class="fas fa-chevron-right"></i></button>
        </div>
    </nav>
}

@code {
    [Parameter, EditorRequired]
    public ListPageState State { get; set; } = default!;

    [Parameter]
    public int TotalCount { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    private async Task OnPrev()
    {
        State.Prev();
        await Changed.InvokeAsync();
    }

    private async Task OnNext()
    {
        State.Next(TotalCount);
        await Changed.InvokeAsync();
    }
}
